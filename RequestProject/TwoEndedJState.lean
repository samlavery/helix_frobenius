import RequestProject.GrownFiberEvolution
import RequestProject.GeometricReadout

/-!
# The two-ended grown 3D state with its second end generated by J, and the chart parameter that
represents both ends

Reversal of the lossy map identified in `TwoEndedGrownState`: the two ends are built from the
fiber's own data (a positive amplitude law and a unimodular bucket at each site, the carrier's
spin at the ordinate, the head window), the second end is generated by J = conjugation phasor by
phasor, and no exponent occurs anywhere upstream.  Only afterwards is a chart parameter `s` asked
to represent the state.

* `FiberData`, `endPhasor`, `jEndPhasor`, `grownEnd`, `grownJEnd` — the two-ended grown state.
  J magnitude equality: `norm_jEndPhasor`, `norm_grownJEnd`.  A focal cancellation is one event of
  both ends: `grownJEnd_eq_zero_iff`.
* `chartData σ`, `finiteFiber_eq_grownEnd` — the compiled grown fiber is the helix end of the
  chart datum with amplitude law `n^{−σ}`.
* `RepresentsHelixEnd`, `RepresentsJEnd`, `RepresentsBothEnds` — the chart reads the helix end at
  `s` (`phasorTerm_norm`: amplitude `n^{−Re s}`) and, by its end-swap convention `s ↦ 1 − s` (the
  second branch of `twoEnded`), the J-end at `1 − s`.
* **`re_eq_half_of_J_readings`**, **`re_eq_half_of_representsBothEnds`** — J magnitude equality
  together with the chart's end-scale ratio `n^{2 Re s − 1}` (`phasorTerm_reflect_norm`) forces
  `Re s = ½`.  No cancellation hypothesis is used.
* `chartData_representsBothEnds_iff` — the chart datum at exponent `σ` is a two-ended J-state the
  chart can represent on both ends iff `σ = ½`: the lossy map reversed.
* `FocalCancellation`, `ordinate_of_spin_readings`, `event_parameter` — the focal cancellation is
  a condition on the ordinate alone; the spins of sites 2 and 3 at the event fix the ordinate; the
  readout of the event's physical height `e^{y₀}` is `y₀`; the event's parameter is
  `½ + i·log Z`, the abscissa from compatibility and the ordinate from the event.

No `ζ`/`L` identity, functional equation, explicit formula, prime, zero set or zero-location
statement is used in any proof.
-/

open Complex Filter Topology Finset
open CriticalLinePhasor
open CriticalLinePhasor.CarrierHeadFiniteFiber
open CriticalLinePhasor.GrownFiber
open CriticalLinePhasor.GrownFiberEvolution

noncomputable section

namespace CriticalLinePhasor.TwoEndedJState

/-! ## 1. The two-ended grown 3D state -/

/-- The fiber's own data at the sites, upstream of any exponent: a positive amplitude and a
unimodular bucket (the sign or character of the channel) at site `k+1`. -/
structure FiberData where
  amp : ℕ → ℝ
  amp_pos : ∀ k, 0 < amp k
  bucket : ℕ → ℂ
  bucket_unit : ∀ k, ‖bucket k‖ = 1

/-- The helix-end phasor at site `k+1` and ordinate `y`: bucket · amplitude · carrier spin. -/
def endPhasor (F : FiberData) (y : ℝ) (k : ℕ) : ℂ :=
  F.bucket k * (F.amp k : ℂ) * LFunctionPhasor.mellinSpin y (k + 1)

/-- The anti-helix end, generated by J: conjugation phasor by phasor. -/
def jEndPhasor (F : FiberData) (y : ℝ) (k : ℕ) : ℂ := (starRingEnd ℂ) (endPhasor F y k)

theorem norm_endPhasor (F : FiberData) (y : ℝ) (k : ℕ) : ‖endPhasor F y k‖ = F.amp k := by
  unfold endPhasor
  rw [norm_mul, norm_mul, F.bucket_unit, LFunctionPhasor.mellinSpin_norm, Complex.norm_real,
    Real.norm_eq_abs, abs_of_pos (F.amp_pos k)]
  ring

/-- **J magnitude equality**: the anti-helix end has the same amplitude at every site. -/
theorem norm_jEndPhasor (F : FiberData) (y : ℝ) (k : ℕ) : ‖jEndPhasor F y k‖ = F.amp k := by
  unfold jEndPhasor
  rw [Complex.norm_conj, norm_endPhasor]

theorem conj_mellinSpin (y : ℝ) (n : ℕ) :
    (starRingEnd ℂ) (LFunctionPhasor.mellinSpin y n) = LFunctionPhasor.mellinSpin (-y) n := by
  unfold LFunctionPhasor.mellinSpin
  rw [← Complex.exp_conj]
  congr 1
  simp only [map_mul, map_neg, Complex.conj_I, Complex.conj_ofReal, Complex.ofReal_neg]
  ring

/-- The J-end spins the opposite way with the same amplitude. -/
theorem jEndPhasor_eq (F : FiberData) (y : ℝ) (k : ℕ) :
    jEndPhasor F y k =
      (starRingEnd ℂ) (F.bucket k) * (F.amp k : ℂ) * LFunctionPhasor.mellinSpin (-y) (k + 1) := by
  unfold jEndPhasor endPhasor
  rw [map_mul, map_mul, Complex.conj_ofReal, conj_mellinSpin]

/-- The grown helix end at head `Z`, ordinate `y`. -/
def grownEnd (F : FiberData) (Z y : ℝ) : ℂ :=
  ∑ k ∈ range ⌈Z⌉₊, ((headWindow Z k : ℝ) : ℂ) * endPhasor F y k

/-- The grown anti-helix end, generated by J. -/
def grownJEnd (F : FiberData) (Z y : ℝ) : ℂ :=
  ∑ k ∈ range ⌈Z⌉₊, ((headWindow Z k : ℝ) : ℂ) * jEndPhasor F y k

theorem grownJEnd_eq_conj (F : FiberData) (Z y : ℝ) :
    grownJEnd F Z y = (starRingEnd ℂ) (grownEnd F Z y) := by
  unfold grownJEnd grownEnd jEndPhasor
  rw [map_sum]
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [map_mul, Complex.conj_ofReal]

theorem norm_grownJEnd (F : FiberData) (Z y : ℝ) : ‖grownJEnd F Z y‖ = ‖grownEnd F Z y‖ := by
  rw [grownJEnd_eq_conj, Complex.norm_conj]

/-- **A focal cancellation is one event of the two-ended state**: the J-end cancels exactly when
the helix end does. -/
theorem grownJEnd_eq_zero_iff (F : FiberData) (Z y : ℝ) :
    grownJEnd F Z y = 0 ↔ grownEnd F Z y = 0 := by
  rw [grownJEnd_eq_conj]
  constructor
  · intro h
    have := congrArg (starRingEnd ℂ) h
    simpa using this
  · intro h
    rw [h, map_zero]

/-! ## 2. The compiled grown fiber is the helix end of the chart datum -/

/-- The chart's amplitude law with exponent `σ` and the alternating bucket, as a fiber datum. -/
def chartData (σ : ℝ) : FiberData where
  amp k := ((k : ℝ) + 1) ^ (-σ)
  amp_pos k := Real.rpow_pos_of_pos (by positivity) _
  bucket k := (-1 : ℂ) ^ k
  bucket_unit k := by rw [norm_pow, norm_neg, norm_one, one_pow]

theorem finiteFiber_eq_grownEnd (σ y Z : ℝ) :
    finiteFiber Z ((σ : ℂ) + (y : ℂ) * Complex.I) = grownEnd (chartData σ) Z y := by
  rw [finiteFiber_eq_window_input]
  unfold grownEnd
  refine Finset.sum_congr rfl fun k _ => ?_
  congr 1
  unfold inputPhasor endPhasor chartData LFunctionPhasor.mellinSpin
  simp only
  have hk : (0 : ℝ) < (k : ℝ) + 1 := by positivity
  have hne : ((k : ℂ) + 1) ≠ 0 := by exact_mod_cast hk.ne'
  have hlog : Complex.log ((k : ℂ) + 1) = (Real.log ((k : ℝ) + 1) : ℂ) := by
    rw [show ((k : ℂ) + 1) = (((k : ℝ) + 1 : ℝ) : ℂ) by push_cast; rfl, ← Complex.ofReal_log hk.le]
  have hne' : ((((k : ℝ) + 1 : ℝ)) : ℂ) ≠ 0 := by exact_mod_cast hk.ne'
  rw [Complex.cpow_def_of_ne_zero hne, hlog, Complex.ofReal_cpow hk.le,
    Complex.cpow_def_of_ne_zero hne', ← Complex.ofReal_log hk.le]
  push_cast
  rw [mul_assoc, ← Complex.exp_add]
  congr 1
  congr 1
  ring

/-! ## 3. The chart parameter representing both J-related ends -/

/-- The chart reads a one-ended fiber at parameter `s` with the amplitude law `n^{−Re s}`
(`LFunctionPhasor.phasorTerm_norm`).  `F` is represented at `s` on its helix end when its
amplitude law is proportional to that reading. -/
def RepresentsHelixEnd (F : FiberData) (s : ℂ) : Prop :=
  ∃ c : ℝ, 0 < c ∧ ∀ k, ‖endPhasor F 0 k‖ = c * ((k : ℝ) + 1) ^ (-s.re)

/-- The chart's convention for the end swap is `s ↦ 1 − s` (the second branch of `twoEnded`):
the J-end is read at the reflected parameter.  `F` is represented at `s` on its anti-helix end
when the J-end's amplitude law is proportional to the chart's reading at `1 − s`. -/
def RepresentsJEnd (F : FiberData) (s : ℂ) : Prop :=
  ∃ c : ℝ, 0 < c ∧ ∀ k, ‖jEndPhasor F 0 k‖ = c * ((k : ℝ) + 1) ^ (-(1 - s).re)

/-- One chart parameter representing both J-related ends of one state. -/
def RepresentsBothEnds (F : FiberData) (s : ℂ) : Prop :=
  RepresentsHelixEnd F s ∧ RepresentsJEnd F s

/-- The chart's end-scale ratio: reading one site at `1 − s` instead of `s` changes the amplitude
by `n^{2 Re s − 1}`. -/
theorem phasorTerm_reflect_norm (χ : ℕ → ℂ) (s : ℂ) (y : ℝ) {n : ℕ} (hn : 0 < n) :
    ‖LFunctionPhasor.phasorTerm χ (1 - s).re y n‖ =
      (n : ℝ) ^ (2 * s.re - 1) * ‖LFunctionPhasor.phasorTerm χ s.re y n‖ := by
  rw [LFunctionPhasor.phasorTerm_norm χ _ y n hn, LFunctionPhasor.phasorTerm_norm χ _ y n hn,
    Complex.sub_re, Complex.one_re]
  have hn' : (0 : ℝ) < n := by exact_mod_cast hn
  rw [mul_left_comm, ← Real.rpow_add hn']
  congr 2
  ring

/-- **J magnitude equality + the chart's end-scale ratio ⟹ `Re s = ½`.**  If the chart's reading
of the helix end at `s` and its reading of the J-end at `1 − s` both give the actual end magnitude
at one site `k+1 ≥ 2`, then `Re s = ½`.  No cancellation hypothesis. -/
theorem re_eq_half_of_J_readings {χ : ℕ → ℂ} (hχ : ∀ n, ‖χ n‖ = 1) {s : ℂ} {y y' : ℝ}
    {F : FiberData} {k : ℕ} (hk : 1 ≤ k)
    (hH : ‖LFunctionPhasor.phasorTerm χ s.re y (k + 1)‖ = ‖endPhasor F y k‖)
    (hJ : ‖LFunctionPhasor.phasorTerm χ (1 - s).re y' (k + 1)‖ = ‖jEndPhasor F y' k‖) :
    s.re = 1 / 2 := by
  rw [LFunctionPhasor.phasorTerm_norm χ _ _ _ (Nat.succ_pos k), hχ, one_mul, norm_endPhasor] at hH
  rw [LFunctionPhasor.phasorTerm_norm χ _ _ _ (Nat.succ_pos k), hχ, one_mul, norm_jEndPhasor,
    Complex.sub_re, Complex.one_re] at hJ
  have hb : (1 : ℝ) < ((k + 1 : ℕ) : ℝ) := by
    have : (1 : ℝ) ≤ k := by exact_mod_cast hk
    push_cast
    linarith
  have := (Real.strictMono_rpow_of_base_gt_one hb).injective (hH.trans hJ.symm)
  linarith

/-- **Geometric compatibility fixes the abscissa.** -/
theorem re_eq_half_of_representsBothEnds {F : FiberData} {s : ℂ} (h : RepresentsBothEnds F s) :
    s.re = 1 / 2 := by
  obtain ⟨⟨c, hc, hH⟩, ⟨c', hc', hJ⟩⟩ := h
  have h0 := hH 0
  have h0' := hJ 0
  rw [norm_endPhasor] at h0
  rw [norm_jEndPhasor] at h0'
  simp only [Nat.cast_zero, zero_add, Real.one_rpow, mul_one] at h0 h0'
  have h1 := hH 1
  have h1' := hJ 1
  rw [norm_endPhasor] at h1
  rw [norm_jEndPhasor] at h1'
  simp only [Nat.cast_one, Complex.sub_re, Complex.one_re] at h1 h1'
  have hcc : c = c' := by rw [← h0, ← h0']
  rw [← hcc] at h1'
  have h2 : (1 + 1 : ℝ) ^ (-s.re) = (1 + 1 : ℝ) ^ (-(1 - s.re)) :=
    mul_left_cancel₀ hc.ne' (h1.symm.trans h1')
  have := (Real.strictMono_rpow_of_base_gt_one (by norm_num : (1 : ℝ) < 1 + 1)).injective h2
  linarith

theorem representsBothEnds_of_re_eq_half {F : FiberData} {s : ℂ} (hs : s.re = 1 / 2)
    (h : RepresentsHelixEnd F s) : RepresentsBothEnds F s := by
  refine ⟨h, ?_⟩
  obtain ⟨c, hc, hH⟩ := h
  refine ⟨c, hc, fun k => ?_⟩
  rw [norm_jEndPhasor, ← norm_endPhasor F 0 k, hH k, Complex.sub_re, Complex.one_re, hs]
  norm_num

theorem chartData_representsHelixEnd (σ y : ℝ) :
    RepresentsHelixEnd (chartData σ) ((σ : ℂ) + (y : ℂ) * Complex.I) := by
  refine ⟨1, one_pos, fun k => ?_⟩
  rw [norm_endPhasor]
  simp [chartData]

/-- **The lossy map reversed**: the chart datum at exponent `σ` is a two-ended J-state that the
chart can represent on both ends iff `σ = ½`. -/
theorem chartData_representsBothEnds_iff (σ y : ℝ) :
    RepresentsBothEnds (chartData σ) ((σ : ℂ) + (y : ℂ) * Complex.I) ↔ σ = 1 / 2 := by
  constructor
  · intro h
    have := re_eq_half_of_representsBothEnds h
    simpa using this
  · intro h
    exact representsBothEnds_of_re_eq_half (by simp [h]) (chartData_representsHelixEnd σ y)

/-! ## 4. The focal cancellation fixes the ordinate, and only the ordinate -/

/-- A focal cancellation of the two-ended state at ordinate `y₀`, at the carrier's own head
there.  No exponent occurs: the condition is on the ordinate alone. -/
def FocalCancellation (F : FiberData) (y₀ : ℝ) : Prop := grownEnd F (physicalHead y₀) y₀ = 0

theorem focalCancellation_iff_jEnd (F : FiberData) (y₀ : ℝ) :
    FocalCancellation F y₀ ↔ grownJEnd F (physicalHead y₀) y₀ = 0 := by
  unfold FocalCancellation
  rw [grownJEnd_eq_zero_iff]

/-- The physical height of an event at ordinate `y₀` is `e^{y₀}`; its readout is `y₀`. -/
def eventHeight (y₀ : ℝ) : ℝ := Real.exp y₀

theorem heightReadout_eventHeight (y₀ : ℝ) :
    Readout.heightReadout (eventHeight y₀) = y₀ :=
  Readout.readout_exp y₀

/-- `log 3 / log 2` is irrational: `q · log 3 = p · log 2` has no solution with `q ≥ 1`. -/
theorem log_three_div_log_two_irrational (p : ℤ) (q : ℕ) (hq : 1 ≤ q)
    (h : (q : ℝ) * Real.log 3 = (p : ℝ) * Real.log 2) : False := by
  have hl3 : 0 < Real.log 3 := Real.log_pos (by norm_num)
  have hl2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hq' : (0 : ℝ) < q := by exact_mod_cast hq
  have hlhs : 0 < (q : ℝ) * Real.log 3 := mul_pos hq' hl3
  have hp : 0 < p := by
    by_contra hle
    have hle' : p ≤ 0 := not_lt.mp hle
    have : (p : ℝ) * Real.log 2 ≤ 0 :=
      mul_nonpos_of_nonpos_of_nonneg (by exact_mod_cast hle') hl2.le
    linarith
  obtain ⟨m, hm⟩ : ∃ m : ℕ, (m : ℤ) = p := ⟨p.toNat, Int.toNat_of_nonneg hp.le⟩
  have hm1 : 1 ≤ m := by omega
  have hmr : ((m : ℕ) : ℝ) = (p : ℝ) := by exact_mod_cast hm
  rw [← hmr] at h
  have h3 : Real.log ((3 : ℝ) ^ q) = Real.log ((2 : ℝ) ^ m) := by
    rw [Real.log_pow, Real.log_pow]
    exact h
  have heq : (3 : ℝ) ^ q = (2 : ℝ) ^ m :=
    Real.log_injOn_pos (Set.mem_Ioi.mpr (by positivity)) (Set.mem_Ioi.mpr (by positivity)) h3
  have hnat : (3 : ℕ) ^ q = 2 ^ m := by exact_mod_cast heq
  have hodd : Odd ((3 : ℕ) ^ q) := Odd.pow (by decide)
  have heven : Even ((2 : ℕ) ^ m) := Nat.even_pow.mpr ⟨even_two, by omega⟩
  rw [hnat] at hodd
  exact (Nat.not_even_iff_odd.mpr hodd) heven

/-- **The spins of sites 2 and 3 at the event fix the ordinate.**  If the chart's spin parameter
`t` reproduces the carrier's spin at ordinate `y₀` at sites `2` and `3`, then `t = y₀`. -/
theorem ordinate_of_spin_readings {t y₀ : ℝ}
    (h2 : LFunctionPhasor.mellinSpin t 2 = LFunctionPhasor.mellinSpin y₀ 2)
    (h3 : LFunctionPhasor.mellinSpin t 3 = LFunctionPhasor.mellinSpin y₀ 3) : t = y₀ := by
  unfold LFunctionPhasor.mellinSpin at h2 h3
  rw [Complex.exp_eq_exp_iff_exists_int] at h2 h3
  obtain ⟨a, ha⟩ := h2
  obtain ⟨b, hb⟩ := h3
  push_cast at ha hb
  have ha' : (y₀ - t) * Real.log 2 = (a : ℝ) * (2 * Real.pi) := by
    have h1 : ((-(t * Real.log 2) : ℝ) : ℂ) * Complex.I
        = ((-(y₀ * Real.log 2) + (a : ℝ) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I := by
      push_cast
      linear_combination ha
    have h2' := Complex.ofReal_injective (mul_right_cancel₀ Complex.I_ne_zero h1)
    linarith
  have hb' : (y₀ - t) * Real.log 3 = (b : ℝ) * (2 * Real.pi) := by
    have h1 : ((-(t * Real.log 3) : ℝ) : ℂ) * Complex.I
        = ((-(y₀ * Real.log 3) + (b : ℝ) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I := by
      push_cast
      linear_combination hb
    have h2' := Complex.ofReal_injective (mul_right_cancel₀ Complex.I_ne_zero h1)
    linarith
  by_contra hne
  have hd : y₀ - t ≠ 0 := sub_ne_zero.mpr (Ne.symm hne)
  have hlog2 : Real.log 2 ≠ 0 := (Real.log_pos (by norm_num : (1 : ℝ) < 2)).ne'
  have key : (y₀ - t) * ((a : ℝ) * Real.log 3) = (y₀ - t) * ((b : ℝ) * Real.log 2) := by
    calc (y₀ - t) * ((a : ℝ) * Real.log 3) = (a : ℝ) * ((y₀ - t) * Real.log 3) := by ring
      _ = (a : ℝ) * ((b : ℝ) * (2 * Real.pi)) := by rw [hb']
      _ = (b : ℝ) * ((a : ℝ) * (2 * Real.pi)) := by ring
      _ = (b : ℝ) * ((y₀ - t) * Real.log 2) := by rw [ha']
      _ = (y₀ - t) * ((b : ℝ) * Real.log 2) := by ring
  have key' : (a : ℝ) * Real.log 3 = (b : ℝ) * Real.log 2 := mul_left_cancel₀ hd key
  rcases lt_trichotomy a 0 with hlt | heq0 | hgt
  · obtain ⟨q, hq⟩ : ∃ q : ℕ, (q : ℤ) = -a := ⟨(-a).toNat, Int.toNat_of_nonneg (by omega)⟩
    have hq1 : 1 ≤ q := by omega
    apply log_three_div_log_two_irrational (-b) q hq1
    have hqr : ((q : ℕ) : ℝ) = -(a : ℝ) := by exact_mod_cast hq
    rw [hqr]
    push_cast
    linear_combination -key'
  · subst heq0
    rw [Int.cast_zero, zero_mul] at ha'
    rcases mul_eq_zero.mp ha' with h0 | h0
    · exact hd h0
    · exact hlog2 h0
  · obtain ⟨q, hq⟩ : ∃ q : ℕ, (q : ℤ) = a := ⟨a.toNat, Int.toNat_of_nonneg hgt.le⟩
    have hq1 : 1 ≤ q := by omega
    apply log_three_div_log_two_irrational b q hq1
    have hqr : ((q : ℕ) : ℝ) = (a : ℝ) := by exact_mod_cast hq
    rw [hqr]
    exact key'

/-- **The decomposition.**  For a two-ended J-state represented on both ends by `s` and read with
the carrier's spin at the event ordinate `y₀`: the abscissa is fixed by geometric compatibility
alone (no cancellation used), the ordinate is fixed by the spin at the event alone (no amplitude
used), and the event's parameter is `½ + i·log Z` with `Z = e^{y₀}` the event's height. -/
theorem event_parameter {F : FiberData} {s : ℂ} (h : RepresentsBothEnds F s) {y₀ : ℝ}
    (hspin2 : LFunctionPhasor.mellinSpin s.im 2 = LFunctionPhasor.mellinSpin y₀ 2)
    (hspin3 : LFunctionPhasor.mellinSpin s.im 3 = LFunctionPhasor.mellinSpin y₀ 3) :
    s = (1 / 2 : ℂ) + Complex.I * (Readout.heightReadout (eventHeight y₀) : ℂ) := by
  have hre := re_eq_half_of_representsBothEnds h
  have him := ordinate_of_spin_readings hspin2 hspin3
  rw [heightReadout_eventHeight]
  apply Complex.ext
  · simp [hre]
  · simp [him]

end CriticalLinePhasor.TwoEndedJState

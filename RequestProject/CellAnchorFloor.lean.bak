import Mathlib

/-!
# The cell-anchor floor: why π/3 anchors have a floor and unit anchors do not

The mechanism behind the measured contour law (`tmp/att559`): anchoring on
the harmonic cell `π/3` guarantees a floor for the leading phase factor,
while anchoring on the unit/Gram scale `π` guarantees nothing.

* `cos_sq_cell_sum` — the exact DC identity: the three π/3-cell values of
  `cos²` sum to `3/2`, **independently of the phase**.  (Closure: the three
  doubled phases are the cube roots of unity and cancel exactly.)
* `cell_anchor_floor` — hence some cell anchor has `|cos| ≥ √2/2`.  No
  estimate is involved: the floor is forced by the exact closure.
  (The sharp constant is `√3/2`, attained at `φ = π/6`; `√2/2` is what the
  sum-of-squares pigeonhole gives.)
* `flat_anchor_no_floor` — at unit spacing `π` every anchor carries the
  SAME value `|cos φ|`, which vanishes at `φ = π/2`: the unit chart has no
  floor at all.  This is the `unit-1 → false null` law as a theorem.

No `sorry`, no `axiom`.
-/

open Real

noncomputable section

namespace CriticalLinePhasor.CellAnchor

/-- **The exact cell DC identity**: the three π/3-cell values of `cos²`
sum to `3/2` for every phase. -/
theorem cos_sq_cell_sum (φ : ℝ) :
    Real.cos φ ^ 2 + Real.cos (φ + π/3) ^ 2 + Real.cos (φ + 2*π/3) ^ 2
      = 3/2 := by
  have h23 : (2:ℝ)*π/3 = π - π/3 := by ring
  have hc3 : Real.cos (π/3) = 1/2 := Real.cos_pi_div_three
  have hs3 : Real.sin (π/3) = Real.sqrt 3 / 2 := Real.sin_pi_div_three
  have hpyth : Real.sin φ ^ 2 + Real.cos φ ^ 2 = 1 := Real.sin_sq_add_cos_sq φ
  have hsqrt3 : Real.sqrt 3 ^ 2 = 3 := Real.sq_sqrt (by norm_num)
  rw [h23, Real.cos_add, Real.cos_add, Real.cos_pi_sub, Real.sin_pi_sub,
    hc3, hs3]
  nlinarith [hpyth, hsqrt3]

/-- **The cell-anchor floor**: some π/3 anchor keeps the phase factor above
`√2/2`.  Forced by the exact closure identity, not estimated. -/
theorem cell_anchor_floor (φ : ℝ) :
    Real.sqrt 2 / 2 ≤ max |Real.cos φ|
      (max |Real.cos (φ + π/3)| |Real.cos (φ + 2*π/3)|) := by
  set M := max |Real.cos φ|
    (max |Real.cos (φ + π/3)| |Real.cos (φ + 2*π/3)|) with hM
  have h0 : (0:ℝ) ≤ M := le_trans (abs_nonneg _) (le_max_left _ _)
  have b1 : |Real.cos φ| ≤ M := le_max_left _ _
  have b2 : |Real.cos (φ + π/3)| ≤ M :=
    le_trans (le_max_left _ _) (le_max_right _ _)
  have b3 : |Real.cos (φ + 2*π/3)| ≤ M :=
    le_trans (le_max_right _ _) (le_max_right _ _)
  have s1 : Real.cos φ ^ 2 ≤ M ^ 2 := by
    nlinarith [abs_nonneg (Real.cos φ), sq_abs (Real.cos φ)]
  have s2 : Real.cos (φ + π/3) ^ 2 ≤ M ^ 2 := by
    nlinarith [abs_nonneg (Real.cos (φ + π/3)), sq_abs (Real.cos (φ + π/3))]
  have s3 : Real.cos (φ + 2*π/3) ^ 2 ≤ M ^ 2 := by
    nlinarith [abs_nonneg (Real.cos (φ + 2*π/3)),
      sq_abs (Real.cos (φ + 2*π/3))]
  have hsum := cos_sq_cell_sum φ
  have hM2 : (1:ℝ)/2 ≤ M ^ 2 := by linarith
  have hsqrt2 : Real.sqrt 2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)
  have hsqrt2pos : (0:ℝ) < Real.sqrt 2 := Real.sqrt_pos.mpr (by norm_num)
  nlinarith [hM2, h0, hsqrt2, hsqrt2pos]

/-- **The unit chart has no floor**: at spacing `π` every anchor carries the
same value, and at `φ = π/2` they all vanish. -/
theorem flat_anchor_no_floor :
    ∃ φ : ℝ, ∀ k : ℤ, |Real.cos (φ + k * π)| = 0 := by
  refine ⟨π/2, fun k => ?_⟩
  rw [Real.cos_add_int_mul_pi, abs_mul, Real.cos_pi_div_two]
  simp


/-- `|x|` never exceeds the larger of `|B+x|`, `|B−x|`: a shift cannot hide
both sides of a symmetric pair. -/
theorem abs_le_max_add_sub (B x : ℝ) : |x| ≤ max |B + x| |B - x| := by
  have htri : |(B + x) - (B - x)| ≤ |B + x| + |B - x| := abs_sub _ _
  have hx : (B + x) - (B - x) = 2 * x := by ring
  rw [hx, abs_mul] at htri
  have h2 : |(2:ℝ)| = 2 := by norm_num
  rw [h2] at htri
  have hmax : |B + x| + |B - x| ≤ 2 * max |B + x| |B - x| := by
    have h1 : |B + x| ≤ max |B + x| |B - x| := le_max_left _ _
    have h2' : |B - x| ≤ max |B + x| |B - x| := le_max_right _ _
    linarith
  linarith

/-- **The background-immune cell floor** — the bank form.  A leading clock
of amplitude `A`, sampled at the three π/3 cells with both signs (the μ6
cycle), clears `A·√2/2` at some anchor **no matter what background `B` the
rest of the bank contributes**.  The background cancels in the ± pair, so
the floor is carried by the closure alone: an exact pigeonhole, not an
estimate.  This is what a contour lower bound for a full clock bank needs
— the higher clocks cannot conspire to suppress every anchor. -/
theorem cell_floor_background (B A φ : ℝ) (hA : 0 ≤ A) :
    A * (Real.sqrt 2 / 2)
      ≤ max (max |B + A * Real.cos φ| |B - A * Real.cos φ|)
          (max (max |B + A * Real.cos (φ + π/3)| |B - A * Real.cos (φ + π/3)|)
               (max |B + A * Real.cos (φ + 2*π/3)|
                    |B - A * Real.cos (φ + 2*π/3)|)) := by
  have hcell := cell_anchor_floor φ
  set M := max |Real.cos φ|
    (max |Real.cos (φ + π/3)| |Real.cos (φ + 2*π/3)|) with hM
  have hstep : A * (Real.sqrt 2 / 2) ≤ A * M :=
    mul_le_mul_of_nonneg_left hcell hA
  refine le_trans hstep ?_
  rw [hM, mul_max_of_nonneg _ _ hA, mul_max_of_nonneg _ _ hA]
  apply max_le_max
  · calc A * |Real.cos φ| = |A * Real.cos φ| := by
          rw [abs_mul, abs_of_nonneg hA]
      _ ≤ max |B + A * Real.cos φ| |B - A * Real.cos φ| :=
          abs_le_max_add_sub _ _
  · apply max_le_max
    · calc A * |Real.cos (φ + π/3)| = |A * Real.cos (φ + π/3)| := by
            rw [abs_mul, abs_of_nonneg hA]
        _ ≤ max |B + A * Real.cos (φ + π/3)| |B - A * Real.cos (φ + π/3)| :=
            abs_le_max_add_sub _ _
    · calc A * |Real.cos (φ + 2*π/3)| = |A * Real.cos (φ + 2*π/3)| := by
            rw [abs_mul, abs_of_nonneg hA]
        _ ≤ max |B + A * Real.cos (φ + 2*π/3)|
              |B - A * Real.cos (φ + 2*π/3)| :=
            abs_le_max_add_sub _ _


/-- **Second-order cell pigeonhole**: at most ONE of the three π/3 cells can
fall below `1/2`.  If two did, the exact closure `3/2` would be violated
(`1/4 + 1/4 + 1 < 3/2`).  This is the census-many strengthening of
`cell_anchor_floor`: one clear anchor per cycle becomes two. -/
theorem two_cells_clear_half (φ : ℝ) :
    (1/2 ≤ |Real.cos φ| ∨ 1/2 ≤ |Real.cos (φ + π/3)|)
      ∧ (1/2 ≤ |Real.cos φ| ∨ 1/2 ≤ |Real.cos (φ + 2*π/3)|)
      ∧ (1/2 ≤ |Real.cos (φ + π/3)| ∨ 1/2 ≤ |Real.cos (φ + 2*π/3)|) := by
  have hsum := cos_sq_cell_sum φ
  have b0 : Real.cos φ ^ 2 ≤ 1 := by
    nlinarith [Real.neg_one_le_cos φ, Real.cos_le_one φ]
  have b1 : Real.cos (φ + π/3) ^ 2 ≤ 1 := by
    nlinarith [Real.neg_one_le_cos (φ + π/3), Real.cos_le_one (φ + π/3)]
  have b2 : Real.cos (φ + 2*π/3) ^ 2 ≤ 1 := by
    nlinarith [Real.neg_one_le_cos (φ + 2*π/3), Real.cos_le_one (φ + 2*π/3)]
  have sq0 := sq_abs (Real.cos φ)
  have sq1 := sq_abs (Real.cos (φ + π/3))
  have sq2 := sq_abs (Real.cos (φ + 2*π/3))
  refine ⟨?_, ?_, ?_⟩ <;> by_contra hcon <;> push_neg at hcon <;>
    obtain ⟨h1, h2⟩ := hcon <;>
    [ nlinarith [abs_nonneg (Real.cos φ), abs_nonneg (Real.cos (φ + π/3))];
      nlinarith [abs_nonneg (Real.cos φ), abs_nonneg (Real.cos (φ + 2*π/3))];
      nlinarith [abs_nonneg (Real.cos (φ + π/3)),
        abs_nonneg (Real.cos (φ + 2*π/3))] ]

/-- **Census-many flips from the cell floor**: if the bank's background `B`
stays below half the rotating amplitude, then at least TWO of the three
π/3 cell pairs carry a strict sign change (`(B+Ac)(B−Ac) < 0`) — one flip
per zero-gap, the density the compiled flip door
(`rh_of_high_flip_visibility`) consumes. -/
theorem two_cell_pairs_flip (B A φ : ℝ) (hA : 0 < A) (hB : |B| < A/2) :
    ((B + A * Real.cos φ) * (B - A * Real.cos φ) < 0
        ∨ (B + A * Real.cos (φ + π/3)) * (B - A * Real.cos (φ + π/3)) < 0)
      ∧ ((B + A * Real.cos φ) * (B - A * Real.cos φ) < 0
        ∨ (B + A * Real.cos (φ + 2*π/3))
            * (B - A * Real.cos (φ + 2*π/3)) < 0)
      ∧ ((B + A * Real.cos (φ + π/3)) * (B - A * Real.cos (φ + π/3)) < 0
        ∨ (B + A * Real.cos (φ + 2*π/3))
            * (B - A * Real.cos (φ + 2*π/3)) < 0) := by
  have key : ∀ c : ℝ, 1/2 ≤ |c| → (B + A * c) * (B - A * c) < 0 := by
    intro c hc
    have h1 : B ^ 2 < (A/2) ^ 2 := by
      have := abs_nonneg B
      nlinarith [sq_abs B, hB, hA]
    have h2 : (A/2) ^ 2 ≤ (A * c) ^ 2 := by
      have hac : A/2 ≤ A * |c| := by nlinarith
      have : (A * |c|) ^ 2 = (A * c) ^ 2 := by
        rw [mul_pow, mul_pow, sq_abs]
      nlinarith [hac, hA]
    nlinarith [h1, h2]
  obtain ⟨p1, p2, p3⟩ := two_cells_clear_half φ
  exact ⟨p1.imp key key, p2.imp key key, p3.imp key key⟩

end CriticalLinePhasor.CellAnchor

#print axioms CriticalLinePhasor.CellAnchor.cos_sq_cell_sum
#print axioms CriticalLinePhasor.CellAnchor.cell_anchor_floor
#print axioms CriticalLinePhasor.CellAnchor.flat_anchor_no_floor
#print axioms CriticalLinePhasor.CellAnchor.cell_floor_background
#print axioms CriticalLinePhasor.CellAnchor.two_cells_clear_half
#print axioms CriticalLinePhasor.CellAnchor.two_cell_pairs_flip

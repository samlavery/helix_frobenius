/-!
# The Eisenstein-wheel bank construction of `carrier_fiber/carrier_fiber.py`, in Lean

The routing core (the exact wheel, the generator walk, `Routing`, `Routing.coeff`) lives in
`RequestProject.WheelRouting` (ledger 1141); the routed grown fiber lives in
`GrownFiberEvolution` (§5). This module holds the transcription of the Python tables and their
proofs.

* `PeriodicCharacter` — `class PeriodicCharacter` (carrier_fiber.py:160): "Real periodic
  coefficient with lanes +1, -1, and optional neutral 0", read at `n % modulus`; the conductor is
  `modulus`. `etaTrivial`, `trivial`, `chi3`, `chi4`, `chi5`, `chi8`, `legendreCharacter`.
* `siteBank` — the per-site form of `channel_counts` (:396), the resulting routing TABLE.
* `absorbedCount` — `absorption_at_height` (:378); `absorbed_iff`.
* `exactCellMarker` — `exact_cell_marker` (:931); `etaTrivial_exactCellMarker`.

The routing (ledgers 1137–1139): for χ₃ on the π/3 wheel, `antisym_wheelState3`,
`wheelBank3_eq_siteBank`, `chi3_eval_eq_wheel_readout`; for χ₄ on a π/2 wheel built by analogy,
`antisym_wheelState4`. For every code table: `eta_routes`, `chi3_routes`, `chi4_routes`,
`chi5_routes`, `chi8_routes`, `legendre7_routes`, `legendre11_routes`, `legendre13_routes`;
complex: `walkValueC_six`, `chi7c_cube_routes`.

Characters (ledgers 1140–1141): `character_eq_walk` — a Dirichlet character whose units are
generated by a list of generators, with known values there, IS its generator walk;
`character_term_eq_walk_term`; inhabitants `chi4Dirichlet_eq_walk` (one generator) and
`chi8Dirichlet_eq_walk` (two). The character grown fiber is the routed grown fiber of the walk:
`routedInput_walk_eq_phasorTerm`, `routedGrownFiber_walk_eq`, with `chi4_routedGrownFiber` and
`chi8_routedGrownFiber`.
-/

namespace CriticalLinePhasor.EisensteinWheelBank

/-! ## The code's tables -/

/-- `class PeriodicCharacter` (carrier_fiber.py:160): values read at `n % modulus`; the conductor
is `modulus`. The Python coefficients are the floats `+1, −1, 0`; they are integers here, as in
`exact_cell_marker`'s `int(self.character(n))`. -/
structure PeriodicCharacter where
  modulus : ℕ
  modulus_pos : 0 < modulus
  values : Fin modulus → ℤ

/-- `__call__`: `vals[n % modulus]`. -/
def PeriodicCharacter.eval (χ : PeriodicCharacter) (n : ℕ) : ℤ :=
  χ.values ⟨n % χ.modulus, Nat.mod_lt _ χ.modulus_pos⟩

/-- `CHARACTERS["trivial"]`: modulus 1, values `(1,)`. -/
def trivial : PeriodicCharacter := ⟨1, by norm_num, ![1]⟩

/-- `CHARACTERS["eta_trivial"]`: modulus 2, values `(−1, 1)`. -/
def etaTrivial : PeriodicCharacter := ⟨2, by norm_num, ![-1, 1]⟩

/-- `CHARACTERS["chi3"]`: modulus 3, values `(0, 1, −1)`. -/
def chi3 : PeriodicCharacter := ⟨3, by norm_num, ![0, 1, -1]⟩

/-- `CHARACTERS["chi4"]`: modulus 4, values `(0, 1, 0, −1)`. -/
def chi4 : PeriodicCharacter := ⟨4, by norm_num, ![0, 1, 0, -1]⟩

/-- `CHARACTERS["chi5"]`: modulus 5, values `(0, 1, −1, −1, 1)`. -/
def chi5 : PeriodicCharacter := ⟨5, by norm_num, ![0, 1, -1, -1, 1]⟩

/-- `CHARACTERS["chi8"]`: modulus 8, values `(0, 1, 0, −1, 0, −1, 0, 1)`. -/
def chi8 : PeriodicCharacter := ⟨8, by norm_num, ![0, 1, 0, -1, 0, -1, 0, 1]⟩

/-- `legendre_character(p)` (carrier_fiber.py): `0` at `0`, else `1` if
`a^((p−1)/2) ≡ 1 (mod p)` and `−1` otherwise. -/
def legendreCharacter (p : ℕ) (hp : 0 < p) : PeriodicCharacter :=
  ⟨p, hp, fun a => if a.val = 0 then 0 else if a.val ^ ((p - 1) / 2) % p = 1 then 1 else -1⟩

/-- The per-site form of `channel_counts` (carrier_fiber.py:396): positive `c > 0`, negative
`c < 0`, neutral `c == 0`. This is the resulting ROUTING TABLE as the Python reads it off the
coefficient, not the wheel mechanism that produces it (`Routing`, RequestProject.WheelRouting). -/
def siteBank (χ : PeriodicCharacter) (n : ℕ) : Phasor3D.Channel :=
  if 0 < χ.eval n then .positive else if χ.eval n < 0 then .negative else .neutral

/-- `channel_counts(count)` over the sites `indices(count) = 1, …, count`. -/
def channelCount (χ : PeriodicCharacter) (count : ℕ) (c : Phasor3D.Channel) : ℕ :=
  ((Finset.Icc 1 count).filter (fun n => siteBank χ n = c)).card

/-- `absorption_at_height` (carrier_fiber.py:378): `absorbed = floor(height / pitch)`. -/
noncomputable def absorbedCount (height pitch : ℝ) : ℕ := ⌊height / pitch⌋₊

/-- `complete_crossings = absorbed // 6`. -/
noncomputable def completeCrossings (height pitch : ℝ) : ℕ := absorbedCount height pitch / 6

/-- `partial_phasors = absorbed % 6`. -/
noncomputable def partialPhasors (height pitch : ℝ) : ℕ := absorbedCount height pitch % 6

/-- At pitch 1 the height `z ≥ 0` has absorbed site `n` exactly when `n ≤ z`: each site has its
own integer threshold. -/
theorem absorbed_iff {z : ℝ} (hz : 0 ≤ z) (n : ℕ) :
    n ≤ absorbedCount z 1 ↔ (n : ℝ) ≤ z := by
  unfold absorbedCount
  rw [div_one]
  exact Nat.le_floor_iff hz

/-- One slot's contribution in `exact_cell_marker`:
`ZETA6_POWERS[slot % 6].scale(character(slot + 1))`. -/
def slotMarker (χ : PeriodicCharacter) (slot : ℕ) : Eisenstein :=
  (zeta6Powers ⟨slot % 6, Nat.mod_lt _ (by norm_num)⟩).scale (χ.eval (slot + 1))

/-- `exact_cell_marker(block_index)` (carrier_fiber.py:931), `block_index ≥ 1`:
`start_slot = 6·(block_index − 1)`, then the loop over `offset in range(6)`. -/
def exactCellMarker (χ : PeriodicCharacter) (blockIndex : ℕ) : Eisenstein :=
  (List.range 6).foldl (fun total offset => total + slotMarker χ (6 * (blockIndex - 1) + offset)) 0

/-- The η slot contribution depends only on the slot's position in its block. -/
theorem etaTrivial_slotMarker (m offset : ℕ) :
    slotMarker etaTrivial (6 * m + offset) = slotMarker etaTrivial offset := by
  unfold slotMarker PeriodicCharacter.eval
  have h6 : (6 * m + offset) % 6 = offset % 6 := by omega
  have h2 : (6 * m + offset + 1) % 2 = (offset + 1) % 2 := by omega
  simp only [etaTrivial] at *
  rw [show (⟨(6 * m + offset) % 6, Nat.mod_lt _ (by norm_num)⟩ : Fin 6) =
      ⟨offset % 6, Nat.mod_lt _ (by norm_num)⟩ from Fin.ext h6]
  rw [show (⟨(6 * m + offset + 1) % 2, Nat.mod_lt _ (by norm_num)⟩ : Fin 2) =
      ⟨(offset + 1) % 2, Nat.mod_lt _ (by norm_num)⟩ from Fin.ext h2]

/-- **"eta_trivial has exact block cancellation because the signed sixth roots add to zero in
every finite block"** (carrier_fiber.py:413): the exact marker of every block is `0`. -/
theorem etaTrivial_exactCellMarker (blockIndex : ℕ) :
    exactCellMarker etaTrivial blockIndex = 0 := by
  unfold exactCellMarker
  simp only [List.range_succ, List.range_zero, List.nil_append, List.foldl_cons, List.foldl_nil,
    List.foldl_append]
  rw [etaTrivial_slotMarker _ 0, etaTrivial_slotMarker _ 1,
    etaTrivial_slotMarker _ 2, etaTrivial_slotMarker _ 3,
    etaTrivial_slotMarker _ 4, etaTrivial_slotMarker _ 5]
  decide

/-! ## χ₃ on the π/3 Eisenstein wheel (ledger 1137)

character χ₃ → conductor 3 → the π/3 wheel (one cell = π/3, the documented fiber scale,
universal.tex:5772) → wheel state at site `n`, advancing two cells (2π/3) per site → its
conjugate-antisymmetric projection → `+ / 0 / −`. -/

namespace Eisenstein

/-- `__sub__`: `self + (−other)`. -/
instance : Sub Eisenstein := ⟨fun x y => x + -y⟩

/-- Conjugation in the basis `(1, ζ)`: `ζ̄ = 1 − ζ`, so `a + bζ ↦ (a + b) − bζ`. -/
def conj (x : Eisenstein) : Eisenstein := ⟨x.a + x.b, -x.b⟩

/-- `2ζ − 1 = i√3`. -/
def iSqrt3 : Eisenstein := ⟨-1, 2⟩

/-- The conjugate-antisymmetric projection: the integer `m` with `x − x̄ = m · (i√3)`. -/
def antisym (x : Eisenstein) : ℤ := x.b

/-- The projection is what it says: `x − x̄ = (antisym x) · i√3`, exactly. -/
theorem sub_conj (x : Eisenstein) : x - x.conj = iSqrt3.scale x.antisym := by
  ext
  · show x.a + -(x.a + x.b) = x.b * -1
    ring
  · show x.b + -(-x.b) = x.b * 2
    ring

end Eisenstein

/-- χ₃'s stride on the π/3 wheel: two cells per site (an orbit step of 2π/3). -/
def chi3Stride : ℕ := 2

/-- The wheel state at site `n` for conductor 3: the π/3 wheel advanced `chi3Stride · n` cells. -/
def wheelState3 (n : ℕ) : Eisenstein :=
  zeta6Powers ⟨(chi3Stride * n) % 6, Nat.mod_lt _ (by norm_num)⟩

theorem wheelState3_add_three (n : ℕ) : wheelState3 (n + 3) = wheelState3 n := by
  unfold wheelState3
  congr 1
  ext
  show (chi3Stride * (n + 3)) % 6 = (chi3Stride * n) % 6
  unfold chi3Stride
  omega

theorem chi3_eval_add_three (n : ℕ) : chi3.eval (n + 3) = chi3.eval n := by
  unfold PeriodicCharacter.eval
  congr 1
  ext
  show (n + 3) % 3 = n % 3
  omega

/-- **The wheel advances by a fixed rotation:** each site multiplies the state by `ζ²`. -/
theorem wheelState3_succ (n : ℕ) :
    wheelState3 (n + 1) = wheelState3 n * (zeta6Powers 1 * zeta6Powers 1) := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    by_cases h : n < 3
    · interval_cases n <;> decide
    · obtain ⟨m, rfl⟩ : ∃ m, n = m + 3 := ⟨n - 3, by omega⟩
      rw [show m + 3 + 1 = (m + 1) + 3 by omega, wheelState3_add_three, wheelState3_add_three]
      exact ih m (by omega)

/-- **The wheel's antisymmetric readout is the χ₃ routing table**, at every site. -/
theorem antisym_wheelState3 (n : ℕ) : (wheelState3 n).antisym = chi3.eval n := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    by_cases h : n < 3
    · interval_cases n <;> decide
    · obtain ⟨m, rfl⟩ : ∃ m, n = m + 3 := ⟨n - 3, by omega⟩
      rw [wheelState3_add_three, chi3_eval_add_three]
      exact ih m (by omega)

/-- The bank read off an integer sign: positive, negative, neutral. -/
def signBank (m : ℤ) : Phasor3D.Channel :=
  if 0 < m then .positive else if m < 0 then .negative else .neutral

theorem siteBank_eq_signBank (χ : PeriodicCharacter) (n : ℕ) :
    siteBank χ n = signBank (χ.eval n) := rfl

/-- The bank the χ₃ wheel routes site `n` to. -/
def wheelBank3 (n : ℕ) : Phasor3D.Channel := signBank (wheelState3 n).antisym

/-- **`siteBank` for χ₃ is what the wheel says.** -/
theorem wheelBank3_eq_siteBank (n : ℕ) : wheelBank3 n = siteBank chi3 n := by
  rw [siteBank_eq_signBank, wheelBank3, antisym_wheelState3]

/-- The antisymmetric projection, read in ℂ: `(z − z̄)/(i√3)`, by the compiled
`eisenstein_chi3_channel` (`ω − ω̄ = i√3`). -/
theorem Eisenstein.toComplex_antisym (x : Eisenstein) :
    (x.toComplex - (starRingEnd ℂ) x.toComplex) / ((Real.sqrt 3 : ℂ) * Complex.I) =
      (x.antisym : ℂ) := by
  have h3 : (Real.sqrt 3 : ℂ) ≠ 0 := by
    exact_mod_cast (Real.sqrt_pos.mpr (by norm_num : (0 : ℝ) < 3)).ne'
  have hch := HelixEmpiricalCores.eisenstein_chi3_channel
  unfold Eisenstein.toComplex Eisenstein.antisym
  rw [map_add, map_mul, map_intCast, map_intCast]
  rw [show ((x.a : ℂ) + x.b * HelixEmpiricalCores.eisensteinOmega) -
      ((x.a : ℂ) + x.b * (starRingEnd ℂ) HelixEmpiricalCores.eisensteinOmega) =
      (x.b : ℂ) * (HelixEmpiricalCores.eisensteinOmega -
        (starRingEnd ℂ) HelixEmpiricalCores.eisensteinOmega) by ring, hch]
  field_simp

/-- The wheel state at site `n` is the point `ω^{2n}`. -/
theorem wheelState3_toComplex (n : ℕ) :
    (wheelState3 n).toComplex = HelixEmpiricalCores.eisensteinOmega ^ (2 * n) := by
  induction n with
  | zero => simp [wheelState3, zeta6Powers, Eisenstein.toComplex, chi3Stride]
  | succ n ih =>
    rw [wheelState3_succ, Eisenstein.toComplex_mul, Eisenstein.toComplex_mul, ih]
    have h1 : (zeta6Powers 1).toComplex = HelixEmpiricalCores.eisensteinOmega := by
      simp [zeta6Powers, Eisenstein.toComplex]
    rw [h1]
    ring

/-- **The χ₃ routing in ℂ:** `(ω^{2n} − ω̄^{2n})/(i√3)` is the χ₃ table value at every site. -/
theorem chi3_eval_eq_wheel_readout (n : ℕ) :
    (HelixEmpiricalCores.eisensteinOmega ^ (2 * n) -
        (starRingEnd ℂ) HelixEmpiricalCores.eisensteinOmega ^ (2 * n)) /
      ((Real.sqrt 3 : ℂ) * Complex.I) = (chi3.eval n : ℂ) := by
  rw [← map_pow, ← wheelState3_toComplex, Eisenstein.toComplex_antisym, antisym_wheelState3]

/-! ## χ₄ on a π/2 wheel (built by analogy; flagged)

The π/2 wheel is documented only as "χ₄ → π/2" (universal.tex:5773); the code has no exact π/2
wheel. Built as the direct analogue of `ZETA6_POWERS`: the Gaussian units in the basis `(1, i)`,
one cell = π/2, stride one cell per site. -/

/-- Exact `a + b·i`. -/
@[ext] structure Gaussian where
  a : ℤ
  b : ℤ
  deriving DecidableEq, Repr

/-- `i^0, …, i^3` in the basis `(1, i)`. -/
def iPowers : Fin 4 → Gaussian := ![⟨1, 0⟩, ⟨0, 1⟩, ⟨-1, 0⟩, ⟨0, -1⟩]

/-- Conjugation `a + bi ↦ a − bi`. -/
def Gaussian.conj (x : Gaussian) : Gaussian := ⟨x.a, -x.b⟩

/-- `x − x̄ = 2b·i`; the antisymmetric projection, normalized by `2i`, is `b`. -/
def Gaussian.antisym (x : Gaussian) : ℤ := x.b

theorem Gaussian.sub_conj (x : Gaussian) :
    (⟨x.a - x.conj.a, x.b - x.conj.b⟩ : Gaussian) = ⟨0, 2 * x.antisym⟩ := by
  ext <;> simp only [Gaussian.conj, Gaussian.antisym] <;> ring

/-- The wheel state at site `n` for conductor 4: the π/2 wheel advanced one cell per site. -/
def wheelState4 (n : ℕ) : Gaussian := iPowers ⟨n % 4, Nat.mod_lt _ (by norm_num)⟩

theorem wheelState4_add_four (n : ℕ) : wheelState4 (n + 4) = wheelState4 n := by
  unfold wheelState4
  congr 1
  ext
  show (n + 4) % 4 = n % 4
  omega

theorem chi4_eval_add_four (n : ℕ) : chi4.eval (n + 4) = chi4.eval n := by
  unfold PeriodicCharacter.eval
  congr 1
  ext
  show (n + 4) % 4 = n % 4
  omega

/-- **The π/2 wheel's antisymmetric readout is the χ₄ routing table**, at every site. -/
theorem antisym_wheelState4 (n : ℕ) : (wheelState4 n).antisym = chi4.eval n := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    by_cases h : n < 4
    · interval_cases n <;> decide
    · obtain ⟨m, rfl⟩ : ∃ m, n = m + 4 := ⟨n - 4, by omega⟩
      rw [wheelState4_add_four, chi4_eval_add_four]
      exact ih m (by omega)

/-- **`siteBank` for χ₄ is what the π/2 wheel says.** -/
theorem wheelBank4_eq_siteBank (n : ℕ) :
    signBank (wheelState4 n).antisym = siteBank chi4 n := by
  rw [siteBank_eq_signBank, antisym_wheelState4]

/-! ## The routing for every code table (ledger 1139; `Routing` in WheelRouting) -/

/-- The three banks of a real function: position 0 positive, position 3 negative, unreached
neutral. (A complex function uses the other positions as well; its bank is the position.) -/
def realChannel : Option (Fin 6) → Phasor3D.Channel
  | none => .neutral
  | some j => if j = 0 then .positive else if j = 3 then .negative else .neutral

theorem PeriodicCharacter.eval_mod (χ : PeriodicCharacter) (n : ℕ) :
    χ.eval (n % χ.modulus) = χ.eval n := by
  unfold PeriodicCharacter.eval
  congr 1
  ext
  show n % χ.modulus % χ.modulus = n % χ.modulus
  exact Nat.mod_mod _ _

theorem siteBank_mod (χ : PeriodicCharacter) (n : ℕ) :
    siteBank χ (n % χ.modulus) = siteBank χ n := by
  rw [siteBank_eq_signBank, siteBank_eq_signBank, PeriodicCharacter.eval_mod]

/-- A routing that depends only on `n mod q` and matches a table of modulus `q` on the residues
matches it at every site. -/
theorem routes_of_residues {χ : PeriodicCharacter} {r : Routing}
    (hper : ∀ n, r.pos (n % χ.modulus) = r.pos n)
    (h : ∀ n : Fin χ.modulus, realChannel (r.pos n) = siteBank χ n) (n : ℕ) :
    realChannel (r.pos n) = siteBank χ n := by
  rw [← hper n, ← siteBank_mod]
  exact h ⟨n % χ.modulus, Nat.mod_lt _ χ.modulus_pos⟩

theorem walk_pos_mod (q order : ℕ) (gens strides : List ℕ) (n : ℕ) :
    (Routing.walk q order gens strides).pos (n % q) = (Routing.walk q order gens strides).pos n :=
  walkPos_mod q gens _ n

/-- **η support:** the trivial function's η routing is `CHARACTERS["eta_trivial"]` at every site. -/
theorem eta_routes (n : ℕ) : realChannel (Routing.eta.pos n) = siteBank etaTrivial n := by
  refine routes_of_residues (r := .eta) (χ := etaTrivial) (fun n => ?_) (by decide) n
  show some (etaPos (n % 2)) = some (etaPos n)
  congr 1
  ext
  show (3 * (n % 2 + 1)) % 6 = (3 * (n + 1)) % 6
  omega

theorem chi3_routes (n : ℕ) : realChannel ((Routing.walk 3 2 [2] [1]).pos n) = siteBank chi3 n :=
  routes_of_residues (walk_pos_mod 3 2 [2] [1]) (by decide) n

theorem chi4_routes (n : ℕ) : realChannel ((Routing.walk 4 2 [3] [1]).pos n) = siteBank chi4 n :=
  routes_of_residues (walk_pos_mod 4 2 [3] [1]) (by decide) n

theorem chi5_routes (n : ℕ) : realChannel ((Routing.walk 5 2 [2] [1]).pos n) = siteBank chi5 n :=
  routes_of_residues (walk_pos_mod 5 2 [2] [1]) (by decide) n

/-- χ₈: the units mod 8 need two generators (3 and 7); 7 contributes no turn. -/
theorem chi8_routes (n : ℕ) :
    realChannel ((Routing.walk 8 2 [3, 7] [1, 0]).pos n) = siteBank chi8 n :=
  routes_of_residues (walk_pos_mod 8 2 [3, 7] [1, 0]) (by decide) n

theorem legendre7_routes (n : ℕ) :
    realChannel ((Routing.walk 7 2 [3] [1]).pos n) =
      siteBank (legendreCharacter 7 (by norm_num)) n :=
  routes_of_residues (walk_pos_mod 7 2 [3] [1]) (by decide) n

theorem legendre11_routes (n : ℕ) :
    realChannel ((Routing.walk 11 2 [2] [1]).pos n) =
      siteBank (legendreCharacter 11 (by norm_num)) n :=
  routes_of_residues (walk_pos_mod 11 2 [2] [1]) (by decide) n

theorem legendre13_routes (n : ℕ) :
    realChannel ((Routing.walk 13 2 [2] [1]).pos n) =
      siteBank (legendreCharacter 13 (by norm_num)) n :=
  routes_of_residues (walk_pos_mod 13 2 [2] [1]) (by decide) n

/-- The complex wheel at order 6 is the exact Eisenstein wheel (`coeff_walk_eq_toComplex_value`). -/
theorem walkValueC_six (q : ℕ) (gens strides : List ℕ) (n : ℕ) :
    walkValueC q 6 gens strides n = ((Routing.walk q 6 gens strides).value n).toComplex :=
  coeff_walk_eq_toComplex_value q 6 gens strides (dvd_refl 6) n

/-- **The complex sextic χ₇ determines the real one.** `focal_closure`'s `chi7c`
(`character_values(7, 3, 6)`) is the walk `7, [3], [1]`; read at three times its position (its
cube), it routes exactly as `legendre_character(7)`. -/
theorem chi7c_cube_routes (n : ℕ) :
    realChannel ((walkPos 7 [3] [1] n).map (fun j => ⟨(3 * j) % 6, Nat.mod_lt _ (by norm_num)⟩)) =
      siteBank (legendreCharacter 7 (by norm_num)) n := by
  have hres : ∀ r : Fin 7,
      realChannel ((walkPos 7 [3] [1] r).map
          (fun j => (⟨(3 * j) % 6, Nat.mod_lt _ (by norm_num)⟩ : Fin 6))) =
        siteBank (legendreCharacter 7 (by norm_num)) r := by decide
  rw [← walkPos_mod, ← siteBank_mod]
  exact hres ⟨n % 7, Nat.mod_lt _ (by norm_num)⟩

/-! ## A character is its generator walk (ledgers 1140–1141)

Any number of generators. The hypotheses are checkable per character: the generators reach every
unit, and the character's value at each generator. -/

/-- `χ` of a walk residue is one exponential of the strides·steps sum. -/
theorem character_walk_prod {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q) (order : ℕ)
    {gens strides : List ℕ}
    (hχ : List.Forall₂ (fun (g st : ℕ) => χ ((g : ℕ) : ZMod q) =
      Complex.exp (2 * Real.pi * Complex.I * (st : ℂ) / (order : ℂ))) gens strides) :
    ∀ ks : List ℕ, ks.length = gens.length →
      χ (((List.zipWith (fun g k => g ^ k) gens ks).prod : ℕ) : ZMod q) =
        Complex.exp (2 * Real.pi * Complex.I *
          (((List.zipWith (· * ·) strides ks).sum : ℕ) : ℂ) / (order : ℂ)) := by
  induction hχ with
  | nil =>
    intro ks hlen
    rw [List.eq_nil_of_length_eq_zero hlen]
    simp
  | @cons g st gens strides hg _ ih =>
    intro ks hlen
    cases ks with
    | nil => simp at hlen
    | cons k ks' =>
      simp only [List.length_cons, Nat.add_right_cancel_iff] at hlen
      simp only [List.zipWith_cons_cons, List.prod_cons, List.sum_cons]
      rw [Nat.cast_mul, map_mul, Nat.cast_pow, map_pow, hg, ih ks' hlen,
        ← Complex.exp_nat_mul, ← Complex.exp_add]
      congr 1
      push_cast
      ring

/-- **A character is its generator walk.** For a Dirichlet character mod `q` whose units are
reached by the generator walk, with `χ(gᵢ) = exp(2πi·strideᵢ/order)`, the value `χ(n)` at every
site is the complex wheel value of the walk; the wheel state is kept complex. -/
theorem character_eq_walk {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q) (order : ℕ)
    (gens strides : List ℕ)
    (hχ : List.Forall₂ (fun (g st : ℕ) => χ ((g : ℕ) : ZMod q) =
      Complex.exp (2 * Real.pi * Complex.I * (st : ℂ) / (order : ℂ))) gens strides)
    (hgen : ∀ u : (ZMod q)ˣ, ∃ ks ∈ stepTuples q gens.length,
      (((List.zipWith (fun g k => g ^ k) gens ks).prod : ℕ) : ZMod q) = (u : ZMod q))
    (n : ℕ) :
    χ (n : ZMod q) = walkValueC q order gens strides n := by
  unfold walkValueC walkSteps
  split
  · rename_i hnone
    apply MulChar.map_nonunit
    rintro ⟨u, hu⟩
    obtain ⟨ks, hks, hprod⟩ := hgen u
    refine (List.find?_eq_none.mp hnone) ks hks ?_
    unfold walkResidue
    rw [beq_iff_eq]
    exact (ZMod.natCast_eq_natCast_iff' _ _ _).mp (hprod.trans hu)
  · rename_i ks hsome
    have hp := List.find?_some hsome
    unfold walkResidue at hp
    rw [beq_iff_eq] at hp
    have hn : (n : ZMod q) = (((List.zipWith (fun g k => g ^ k) gens ks).prod : ℕ) : ZMod q) :=
      (ZMod.natCast_eq_natCast_iff' _ _ _).mpr hp.symm
    rw [hn]
    exact character_walk_prod χ order hχ ks
      (length_of_mem_stepTuples (List.mem_of_find?_eq_some hsome))

/-- **The character square at one site:** the existing term `χ(n)·n^{−s}` is the routed term. -/
theorem character_term_eq_walk_term {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q) (order : ℕ)
    (gens strides : List ℕ)
    (hχ : List.Forall₂ (fun (g st : ℕ) => χ ((g : ℕ) : ZMod q) =
      Complex.exp (2 * Real.pi * Complex.I * (st : ℂ) / (order : ℂ))) gens strides)
    (hgen : ∀ u : (ZMod q)ˣ, ∃ ks ∈ stepTuples q gens.length,
      (((List.zipWith (fun g k => g ^ k) gens ks).prod : ℕ) : ZMod q) = (u : ZMod q))
    (s : ℂ) (n : ℕ) :
    DirichletPhasorCarrier.phasorTerm χ s n =
      walkValueC q order gens strides n * (n : ℂ) ^ (-s) := by
  unfold DirichletPhasorCarrier.phasorTerm
  rw [character_eq_walk χ order gens strides hχ hgen n]

/-! ### Inhabitants: Mathlib's χ₄ (one generator) and χ₈ (two generators) -/

/-- Mathlib's `ZMod.χ₄` as a Dirichlet character over `ℂ`. -/
noncomputable def chi4Dirichlet : DirichletCharacter ℂ 4 := ZMod.χ₄.ringHomComp (Int.castRingHom ℂ)

/-- Mathlib's `ZMod.χ₈` as a Dirichlet character over `ℂ`. -/
noncomputable def chi8Dirichlet : DirichletCharacter ℂ 8 := ZMod.χ₈.ringHomComp (Int.castRingHom ℂ)

theorem exp_half_turn :
    Complex.exp (2 * Real.pi * Complex.I * ((1 : ℕ) : ℂ) / ((2 : ℕ) : ℂ)) = -1 := by
  rw [show 2 * (Real.pi : ℂ) * Complex.I * ((1 : ℕ) : ℂ) / ((2 : ℕ) : ℂ) = Real.pi * Complex.I by
    push_cast; ring, Complex.exp_pi_mul_I]

theorem exp_no_turn :
    Complex.exp (2 * Real.pi * Complex.I * ((0 : ℕ) : ℂ) / ((2 : ℕ) : ℂ)) = 1 := by
  simp

theorem chi4_walk_values :
    List.Forall₂ (fun (g st : ℕ) => chi4Dirichlet ((g : ℕ) : ZMod 4) =
      Complex.exp (2 * Real.pi * Complex.I * (st : ℂ) / ((2 : ℕ) : ℂ))) [3] [1] := by
  refine .cons ?_ .nil
  show chi4Dirichlet ((3 : ℕ) : ZMod 4) =
    Complex.exp (2 * Real.pi * Complex.I * ((1 : ℕ) : ℂ) / ((2 : ℕ) : ℂ))
  have h3 : ZMod.χ₄ ((3 : ℕ) : ZMod 4) = -1 := by decide
  rw [chi4Dirichlet, MulChar.ringHomComp_apply, h3, exp_half_turn]
  simp

theorem chi4_walk_units : ∀ u : (ZMod 4)ˣ, ∃ ks ∈ stepTuples 4 [3].length,
    (((List.zipWith (fun g k => g ^ k) [3] ks).prod : ℕ) : ZMod 4) = (u : ZMod 4) := by
  decide

theorem chi8_walk_values :
    List.Forall₂ (fun (g st : ℕ) => chi8Dirichlet ((g : ℕ) : ZMod 8) =
      Complex.exp (2 * Real.pi * Complex.I * (st : ℂ) / ((2 : ℕ) : ℂ))) [3, 7] [1, 0] := by
  refine .cons ?_ (.cons ?_ .nil)
  · show chi8Dirichlet ((3 : ℕ) : ZMod 8) =
      Complex.exp (2 * Real.pi * Complex.I * ((1 : ℕ) : ℂ) / ((2 : ℕ) : ℂ))
    have h3 : ZMod.χ₈ ((3 : ℕ) : ZMod 8) = -1 := by decide
    rw [chi8Dirichlet, MulChar.ringHomComp_apply, h3, exp_half_turn]
    simp
  · show chi8Dirichlet ((7 : ℕ) : ZMod 8) =
      Complex.exp (2 * Real.pi * Complex.I * ((0 : ℕ) : ℂ) / ((2 : ℕ) : ℂ))
    have h7 : ZMod.χ₈ ((7 : ℕ) : ZMod 8) = 1 := by decide
    rw [chi8Dirichlet, MulChar.ringHomComp_apply, h7, exp_no_turn]
    simp

theorem chi8_walk_units : ∀ u : (ZMod 8)ˣ, ∃ ks ∈ stepTuples 8 [3, 7].length,
    (((List.zipWith (fun g k => g ^ k) [3, 7] ks).prod : ℕ) : ZMod 8) = (u : ZMod 8) := by
  decide

/-- **Inhabitant, one generator:** Mathlib's χ₄ is the walk `4, [3], [1]` at order 2. -/
theorem chi4Dirichlet_eq_walk (n : ℕ) :
    chi4Dirichlet (n : ZMod 4) = walkValueC 4 2 [3] [1] n :=
  character_eq_walk chi4Dirichlet 2 [3] [1] chi4_walk_values chi4_walk_units n

/-- **Inhabitant, two generators:** Mathlib's χ₈ is the walk `8, [3, 7], [1, 0]` at order 2. -/
theorem chi8Dirichlet_eq_walk (n : ℕ) :
    chi8Dirichlet (n : ZMod 8) = walkValueC 8 2 [3, 7] [1, 0] n :=
  character_eq_walk chi8Dirichlet 2 [3, 7] [1, 0] chi8_walk_values chi8_walk_units n

/-! ## The character grown fiber is the routed grown fiber of its walk (ledger 1141) -/

open GrownFiberEvolution in
/-- **The character square at one site, in the grown fiber:** the routed input of the walk is the
existing `χ(n)·n^{−s}` at `n = k + 1`. -/
theorem routedInput_walk_eq_phasorTerm {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    (order : ℕ) (gens strides : List ℕ)
    (hχ : List.Forall₂ (fun (g st : ℕ) => χ ((g : ℕ) : ZMod q) =
      Complex.exp (2 * Real.pi * Complex.I * (st : ℂ) / (order : ℂ))) gens strides)
    (hgen : ∀ u : (ZMod q)ˣ, ∃ ks ∈ stepTuples q gens.length,
      (((List.zipWith (fun g k => g ^ k) gens ks).prod : ℕ) : ZMod q) = (u : ZMod q))
    (s : ℂ) (k : ℕ) :
    routedInput (.walk q order gens strides) s k = DirichletPhasorCarrier.phasorTerm χ s (k + 1) := by
  rw [character_term_eq_walk_term χ order gens strides hχ hgen s (k + 1)]
  show walkValueC q order gens strides (k + 1) * ((k : ℂ) + 1) ^ (-s) = _
  rw [Nat.cast_add, Nat.cast_one]

open GrownFiberEvolution in
/-- **The character grown fiber:** the routed grown fiber of the walk is the head-windowed sum of
the existing terms `χ(k+1)·(k+1)^{−s}`. -/
theorem routedGrownFiber_walk_eq {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    (order : ℕ) (gens strides : List ℕ)
    (hχ : List.Forall₂ (fun (g st : ℕ) => χ ((g : ℕ) : ZMod q) =
      Complex.exp (2 * Real.pi * Complex.I * (st : ℂ) / (order : ℂ))) gens strides)
    (hgen : ∀ u : (ZMod q)ˣ, ∃ ks ∈ stepTuples q gens.length,
      (((List.zipWith (fun g k => g ^ k) gens ks).prod : ℕ) : ZMod q) = (u : ZMod q))
    (Z : ℝ) (s : ℂ) :
    routedGrownFiber (.walk q order gens strides) Z s =
      ∑ k ∈ Finset.range ⌈Z⌉₊, ((headWindow Z k : ℝ) : ℂ) *
        DirichletPhasorCarrier.phasorTerm χ s (k + 1) := by
  unfold routedGrownFiber
  exact Finset.sum_congr rfl fun k _ => by
    rw [routedInput_walk_eq_phasorTerm χ order gens strides hχ hgen s k]

open GrownFiberEvolution in
/-- Mathlib's χ₄, grown on the carrier. -/
theorem chi4_routedGrownFiber (Z : ℝ) (s : ℂ) :
    routedGrownFiber (.walk 4 2 [3] [1]) Z s =
      ∑ k ∈ Finset.range ⌈Z⌉₊, ((headWindow Z k : ℝ) : ℂ) *
        DirichletPhasorCarrier.phasorTerm chi4Dirichlet s (k + 1) :=
  routedGrownFiber_walk_eq chi4Dirichlet 2 [3] [1] chi4_walk_values chi4_walk_units Z s

open GrownFiberEvolution in
/-- Mathlib's χ₈ (two generators), grown on the carrier. -/
theorem chi8_routedGrownFiber (Z : ℝ) (s : ℂ) :
    routedGrownFiber (.walk 8 2 [3, 7] [1, 0]) Z s =
      ∑ k ∈ Finset.range ⌈Z⌉₊, ((headWindow Z k : ℝ) : ℂ) *
        DirichletPhasorCarrier.phasorTerm chi8Dirichlet s (k + 1) :=
  routedGrownFiber_walk_eq chi8Dirichlet 2 [3, 7] [1, 0] chi8_walk_values chi8_walk_units Z s

/-! ## The routed grown fiber at the first focal consumer (ledger 1142)

The house focal cancellation is `TwoEndedJState.FocalCancellation F y :=
grownEnd F (physicalHead y) y = 0`, stated on `FiberData`: a positive amplitude and a unimodular
bucket at every site. A routing enters it exactly through a unimodular coefficient at every site
(`routingData`, `routedGrownFiber_eq_grownEnd`, `focalCancellation_routed`); η does
(`eta_coeff_unit`, `focalCancellation_routed_eta`). A character walk has coefficient `0` at the
conductor (`walk_coeff_at_conductor`), so it does not (`walk_routing_not_unit`); the existing 3D
phasor carries that site on its mass axis (`walk_neutral_on_massAxis`). -/

open TwoEndedJState in
/-- A routing with unimodular coefficients and amplitude law `n^{−σ}`, as `FiberData`. -/
noncomputable def routingData (r : Routing) (hunit : ∀ k, ‖r.coeff (k + 1)‖ = 1) (σ : ℝ) :
    FiberData where
  amp k := ((k : ℝ) + 1) ^ (-σ)
  amp_pos k := Real.rpow_pos_of_pos (by positivity) _
  bucket k := r.coeff (k + 1)
  bucket_unit := hunit

open TwoEndedJState GrownFiberEvolution in
/-- **The routed grown fiber is the helix end of its `FiberData`**, for every unimodular routing
(the routed form of `TwoEndedJState.finiteFiber_eq_grownEnd`). -/
theorem routedGrownFiber_eq_grownEnd (r : Routing) (hunit : ∀ k, ‖r.coeff (k + 1)‖ = 1)
    (σ y Z : ℝ) :
    routedGrownFiber r Z ((σ : ℂ) + (y : ℂ) * Complex.I) = grownEnd (routingData r hunit σ) Z y := by
  unfold routedGrownFiber grownEnd
  refine Finset.sum_congr rfl fun k _ => ?_
  congr 1
  unfold routedInput endPhasor routingData LFunctionPhasor.mellinSpin
  simp only
  have hk : (0 : ℝ) < (k : ℝ) + 1 := by positivity
  have hne : ((k : ℂ) + 1) ≠ 0 := by exact_mod_cast hk.ne'
  have hlog : Complex.log ((k : ℂ) + 1) = (Real.log ((k : ℝ) + 1) : ℂ) := by
    rw [show ((k : ℂ) + 1) = (((k : ℝ) + 1 : ℝ) : ℂ) by push_cast; rfl, ← Complex.ofReal_log hk.le]
  have hne' : ((((k : ℝ) + 1 : ℝ)) : ℂ) ≠ 0 := by exact_mod_cast hk.ne'
  rw [Complex.cpow_def_of_ne_zero hne, hlog, Complex.ofReal_cpow hk.le,
    Complex.cpow_def_of_ne_zero hne', ← Complex.ofReal_log hk.le]
  push_cast
  rw [mul_assoc, ← Complex.exp_add]
  congr 1
  congr 1
  ring

open TwoEndedJState in
/-- **The house focal cancellation of a unimodular routing is the vanishing of its routed grown
fiber** at the physical head. -/
theorem focalCancellation_routed (r : Routing) (hunit : ∀ k, ‖r.coeff (k + 1)‖ = 1) (σ y : ℝ) :
    FocalCancellation (routingData r hunit σ) y ↔
      GrownFiberEvolution.routedGrownFiber r (CarrierHeadFiniteFiber.physicalHead y)
        ((σ : ℂ) + (y : ℂ) * Complex.I) = 0 := by
  unfold FocalCancellation
  rw [routedGrownFiber_eq_grownEnd]

/-- η's coefficient is unimodular at every site. -/
theorem eta_coeff_unit (k : ℕ) : ‖Routing.eta.coeff (k + 1)‖ = 1 := by
  rw [coeff_eta]
  simp

open TwoEndedJState in
/-- **η enters the house focal cancellation through the routing.** -/
theorem focalCancellation_routed_eta (σ y : ℝ) :
    FocalCancellation (routingData .eta eta_coeff_unit σ) y ↔
      GrownFiberEvolution.routedGrownFiber .eta (CarrierHeadFiniteFiber.physicalHead y)
        ((σ : ℂ) + (y : ℂ) * Complex.I) = 0 :=
  focalCancellation_routed .eta eta_coeff_unit σ y

/-- **A character walk is neutral at its conductor:** the routed coefficient at `n = q` is `0`. -/
theorem walk_coeff_at_conductor {q : ℕ} [NeZero q] [Fact (1 < q)] (χ : DirichletCharacter ℂ q)
    (order : ℕ) (gens strides : List ℕ)
    (hχ : List.Forall₂ (fun (g st : ℕ) => χ ((g : ℕ) : ZMod q) =
      Complex.exp (2 * Real.pi * Complex.I * (st : ℂ) / (order : ℂ))) gens strides)
    (hgen : ∀ u : (ZMod q)ˣ, ∃ ks ∈ stepTuples q gens.length,
      (((List.zipWith (fun g k => g ^ k) gens ks).prod : ℕ) : ZMod q) = (u : ZMod q)) :
    (Routing.walk q order gens strides).coeff q = 0 := by
  show walkValueC q order gens strides q = 0
  rw [← character_eq_walk χ order gens strides hχ hgen q, ZMod.natCast_self]
  exact MulChar.map_zero χ

/-- **The first failure:** a character walk is not a unimodular routing, so it has no `FiberData`
and does not enter `FocalCancellation` as stated. -/
theorem walk_routing_not_unit {q : ℕ} [NeZero q] [Fact (1 < q)] (χ : DirichletCharacter ℂ q)
    (order : ℕ) (gens strides : List ℕ)
    (hχ : List.Forall₂ (fun (g st : ℕ) => χ ((g : ℕ) : ZMod q) =
      Complex.exp (2 * Real.pi * Complex.I * (st : ℂ) / (order : ℂ))) gens strides)
    (hgen : ∀ u : (ZMod q)ˣ, ∃ ks ∈ stepTuples q gens.length,
      (((List.zipWith (fun g k => g ^ k) gens ks).prod : ℕ) : ZMod q) = (u : ZMod q)) :
    ¬ ∀ k, ‖(Routing.walk q order gens strides).coeff (k + 1)‖ = 1 := by
  intro h
  have hq : 1 ≤ q := le_of_lt (Fact.out : 1 < q)
  have hk := h (q - 1)
  rw [Nat.sub_add_cancel hq, walk_coeff_at_conductor χ order gens strides hχ hgen] at hk
  simp at hk

/-- The existing 3D phasor keeps the neutral site: at the conductor its mass axis is `q^{−σ}`. -/
theorem walk_neutral_on_massAxis {q : ℕ} [NeZero q] [Fact (1 < q)] (χ : DirichletCharacter ℂ q)
    (order : ℕ) (gens strides : List ℕ)
    (hχ : List.Forall₂ (fun (g st : ℕ) => χ ((g : ℕ) : ZMod q) =
      Complex.exp (2 * Real.pi * Complex.I * (st : ℂ) / (order : ℂ))) gens strides)
    (hgen : ∀ u : (ZMod q)ˣ, ∃ ks ∈ stepTuples q gens.length,
      (((List.zipWith (fun g k => g ^ k) gens ks).prod : ℕ) : ZMod q) = (u : ZMod q))
    (σ y : ℝ) :
    Phasor3D.massAxis (Phasor3D.phasor3D (Routing.walk q order gens strides).coeff σ y q) =
      (q : ℝ) ^ (-σ) := by
  rw [Phasor3D.phasor3D_massAxis, walk_coeff_at_conductor χ order gens strides hχ hgen]
  simp

/-- Mathlib's χ₄ and χ₈ fail the unimodularity, at sites 4 and 8. -/
theorem chi4_routing_not_unit : ¬ ∀ k, ‖(Routing.walk 4 2 [3] [1]).coeff (k + 1)‖ = 1 := by
  have : Fact (1 < 4) := ⟨by norm_num⟩
  exact walk_routing_not_unit chi4Dirichlet 2 [3] [1] chi4_walk_values chi4_walk_units

theorem chi8_routing_not_unit : ¬ ∀ k, ‖(Routing.walk 8 2 [3, 7] [1, 0]).coeff (k + 1)‖ = 1 := by
  have : Fact (1 < 8) := ⟨by norm_num⟩
  exact walk_routing_not_unit chi8Dirichlet 2 [3, 7] [1, 0] chi8_walk_values chi8_walk_units

/-! ## The neutral bank: positive amplitude, neutral routing, zero readout (ledger 1143)

Amplitude belongs to the phasor (the carrier's `n^{−σ}`); routing belongs to the wheel. A site with
routed coefficient `0` is a positive-amplitude phasor in the neutral channel of the existing 3D
phasor (`Phasor3D.phasor3D`: on the mass axis); its plane readout, the analytic coefficient, is
`0`. Positive bank, negative bank, neutral bank: every site is present with its full amplitude;
the neutral one contributes no signed advance. -/

/-- A walk coefficient has norm `0` (unreached: neutral) or `1` (reached: a wheel position). -/
theorem norm_walkValueC (q order : ℕ) (gens strides : List ℕ) (n : ℕ) :
    ‖walkValueC q order gens strides n‖ = 0 ∨ ‖walkValueC q order gens strides n‖ = 1 := by
  unfold walkValueC
  split
  · left
    simp
  · right
    rename_i ks _
    generalize (List.zipWith (· * ·) strides ks).sum = S
    rw [show 2 * (Real.pi : ℂ) * Complex.I * ((S : ℕ) : ℂ) / (order : ℂ) =
      ((2 * Real.pi * S / order : ℝ) : ℂ) * Complex.I by push_cast; ring]
    exact Complex.norm_exp_ofReal_mul_I _

/-- Every routed coefficient has norm `0` or `1` at a positive site. -/
theorem routing_coeff_norm (r : Routing) (n : ℕ) (hn : 0 < n) :
    ‖r.coeff n‖ = 0 ∨ ‖r.coeff n‖ = 1 := by
  cases r with
  | eta =>
    right
    obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
    exact eta_coeff_unit k
  | walk q order gens strides => exact norm_walkValueC q order gens strides n

/-- The 3D length of a phasor whose coefficient has norm `0` or `1` is the carrier amplitude. -/
theorem mag3_phasor3D_of_norm (c : ℕ → ℂ) (σ y : ℝ) (n : ℕ) (hn : 0 < n)
    (hc : ‖c n‖ = 0 ∨ ‖c n‖ = 1) :
    Phasor3D.mag3 (Phasor3D.phasor3D c σ y n) = (n : ℝ) ^ (-σ) := by
  have hpos : 0 < (n : ℝ) ^ (-σ) := Real.rpow_pos_of_pos (by exact_mod_cast hn) _
  unfold Phasor3D.mag3 Phasor3D.phasor3D
  simp only
  rw [LFunctionPhasor.phasorTerm_norm c σ y n hn]
  rcases hc with h | h <;> rw [h] <;> simp [Real.sqrt_sq hpos.le]

/-- **Every site keeps its carrier amplitude, whatever the routing**: the routed 3D phasor at site
`n` has length `n^{−σ}`. -/
theorem routed_mag3 (r : Routing) (σ y : ℝ) (n : ℕ) (hn : 0 < n) :
    Phasor3D.mag3 (Phasor3D.phasor3D r.coeff σ y n) = (n : ℝ) ^ (-σ) :=
  mag3_phasor3D_of_norm r.coeff σ y n hn (routing_coeff_norm r n hn)

/-- **A neutrally routed site**: it is in the neutral channel, it is the phasor `(0, n^{−σ})` with
positive mass on the mass axis, and its plane readout is `0`. -/
theorem routed_neutral (r : Routing) (σ y : ℝ) (n : ℕ) (hn : 0 < n) (h : r.coeff n = 0) :
    Phasor3D.channel r.coeff n = .neutral ∧
      Phasor3D.phasor3D r.coeff σ y n = (0, (n : ℝ) ^ (-σ)) ∧
      0 < Phasor3D.massAxis (Phasor3D.phasor3D r.coeff σ y n) ∧
      Phasor3D.mag3 (Phasor3D.phasor3D r.coeff σ y n) = (n : ℝ) ^ (-σ) ∧
      Phasor3D.plane (Phasor3D.phasor3D r.coeff σ y n) = 0 := by
  refine ⟨?_, Phasor3D.phasor3D_neutral _ σ y n h,
    Phasor3D.phasor3D_neutral_mass_pos _ σ y n h hn, routed_mag3 r σ y n hn,
    Phasor3D.phasor3D_neutral_plane_zero _ σ y n h⟩
  simp [Phasor3D.channel, h]

/-- The complex power splits into the carrier amplitude and the Mellin spin. -/
theorem natCast_cpow_split (n : ℕ) (hn : 0 < n) (σ y : ℝ) :
    (n : ℂ) ^ (-((σ : ℂ) + (y : ℂ) * Complex.I)) =
      (((n : ℝ) ^ (-σ) : ℝ) : ℂ) * Complex.exp (-((y : ℂ) * (Real.log n : ℂ)) * Complex.I) := by
  have hk : (0 : ℝ) < n := by exact_mod_cast hn
  have hne : (n : ℂ) ≠ 0 := by exact_mod_cast hn.ne'
  have hlog : Complex.log (n : ℂ) = (Real.log n : ℂ) := by
    rw [show (n : ℂ) = ((n : ℝ) : ℂ) by push_cast; rfl, ← Complex.ofReal_log hk.le]
  have hne' : (((n : ℝ)) : ℂ) ≠ 0 := by exact_mod_cast hk.ne'
  rw [Complex.cpow_def_of_ne_zero hne, hlog, Complex.ofReal_cpow hk.le,
    Complex.cpow_def_of_ne_zero hne', ← Complex.ofReal_log hk.le, ← Complex.exp_add]
  congr 1
  push_cast
  ring

/-- The plane readout of the 3D phasor is the coefficient times `n^{−s}`. -/
theorem plane_phasor3D_eq (c : ℕ → ℂ) (σ y : ℝ) (n : ℕ) (hn : 0 < n) :
    Phasor3D.plane (Phasor3D.phasor3D c σ y n) =
      c n * (n : ℂ) ^ (-((σ : ℂ) + (y : ℂ) * Complex.I)) := by
  rw [Phasor3D.phasor3D_plane]
  unfold LFunctionPhasor.phasorTerm LFunctionPhasor.mellinSpin
  simp only [hn.ne', ↓reduceIte]
  rw [natCast_cpow_split n hn σ y]
  ring

/-- **The readout of the routed 3D phasor is the analytic term**: for a character walk, the plane
readout at site `n` is `χ(n)·n^{−s}`, including `0` at the neutral sites. -/
theorem plane_routed_walk_eq_phasorTerm {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    (order : ℕ) (gens strides : List ℕ)
    (hχ : List.Forall₂ (fun (g st : ℕ) => χ ((g : ℕ) : ZMod q) =
      Complex.exp (2 * Real.pi * Complex.I * (st : ℂ) / (order : ℂ))) gens strides)
    (hgen : ∀ u : (ZMod q)ˣ, ∃ ks ∈ stepTuples q gens.length,
      (((List.zipWith (fun g k => g ^ k) gens ks).prod : ℕ) : ZMod q) = (u : ZMod q))
    (σ y : ℝ) (n : ℕ) (hn : 0 < n) :
    Phasor3D.plane (Phasor3D.phasor3D (Routing.walk q order gens strides).coeff σ y n) =
      DirichletPhasorCarrier.phasorTerm χ ((σ : ℂ) + (y : ℂ) * Complex.I) n := by
  rw [plane_phasor3D_eq _ σ y n hn, character_term_eq_walk_term χ order gens strides hχ hgen]
  rfl

/-- **At the conductor**: the character walk's site `q` is a positive-amplitude neutral phasor,
and its readout is the analytic term `χ(q)·q^{−s} = 0`. -/
theorem walk_conductor_site {q : ℕ} [NeZero q] [Fact (1 < q)] (χ : DirichletCharacter ℂ q)
    (order : ℕ) (gens strides : List ℕ)
    (hχ : List.Forall₂ (fun (g st : ℕ) => χ ((g : ℕ) : ZMod q) =
      Complex.exp (2 * Real.pi * Complex.I * (st : ℂ) / (order : ℂ))) gens strides)
    (hgen : ∀ u : (ZMod q)ˣ, ∃ ks ∈ stepTuples q gens.length,
      (((List.zipWith (fun g k => g ^ k) gens ks).prod : ℕ) : ZMod q) = (u : ZMod q))
    (σ y : ℝ) :
    Phasor3D.channel (Routing.walk q order gens strides).coeff q = .neutral ∧
      Phasor3D.mag3 (Phasor3D.phasor3D (Routing.walk q order gens strides).coeff σ y q) =
        (q : ℝ) ^ (-σ) ∧
      Phasor3D.plane (Phasor3D.phasor3D (Routing.walk q order gens strides).coeff σ y q) =
        DirichletPhasorCarrier.phasorTerm χ ((σ : ℂ) + (y : ℂ) * Complex.I) q ∧
      DirichletPhasorCarrier.phasorTerm χ ((σ : ℂ) + (y : ℂ) * Complex.I) q = 0 := by
  have hq : 0 < q := lt_trans Nat.zero_lt_one (Fact.out : 1 < q)
  have h0 := walk_coeff_at_conductor χ order gens strides hχ hgen
  obtain ⟨hch, -, -, hmag, hpl⟩ := routed_neutral (Routing.walk q order gens strides) σ y q hq h0
  have hread := plane_routed_walk_eq_phasorTerm χ order gens strides hχ hgen σ y q hq
  exact ⟨hch, hmag, hread, hread.symm.trans hpl⟩

/-- **The routed grown fiber is the windowed plane readout of the routed 3D state**, for every
routing — every site present with its carrier amplitude, neutral sites included. -/
theorem routedGrownFiber_eq_plane_sum (r : Routing) (σ y Z : ℝ) :
    GrownFiberEvolution.routedGrownFiber r Z ((σ : ℂ) + (y : ℂ) * Complex.I) =
      ∑ k ∈ Finset.range ⌈Z⌉₊, ((GrownFiberEvolution.headWindow Z k : ℝ) : ℂ) *
        Phasor3D.plane (Phasor3D.phasor3D r.coeff σ y (k + 1)) := by
  unfold GrownFiberEvolution.routedGrownFiber
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [plane_phasor3D_eq r.coeff σ y (k + 1) (Nat.succ_pos k)]
  unfold GrownFiberEvolution.routedInput
  push_cast
  rfl

/-- The carrier amplitude is positive at every site, whatever the routing. -/
theorem carrierAmplitude_pos (n : ℕ) (hn : 0 < n) : 0 < ThreeDFocal.carrierAmplitude n := by
  unfold ThreeDFocal.carrierAmplitude
  exact mul_pos (div_pos Real.pi_pos (by norm_num))
    (Real.rpow_pos_of_pos (by exact_mod_cast hn) _)

/-- **The existing χ-generic focal closure consumes the walk**: on the carrier bank (positive
carrier amplitude at every site), `focalClosure χ` is the vanishing of the routed sum. -/
theorem focalClosure_carrierBank_routed {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    (order : ℕ) (gens strides : List ℕ)
    (hχ : List.Forall₂ (fun (g st : ℕ) => χ ((g : ℕ) : ZMod q) =
      Complex.exp (2 * Real.pi * Complex.I * (st : ℂ) / (order : ℂ))) gens strides)
    (hgen : ∀ u : (ZMod q)ˣ, ∃ ks ∈ stepTuples q gens.length,
      (((List.zipWith (fun g k => g ^ k) gens ks).prod : ℕ) : ZMod q) = (u : ZMod q))
    (N : ℕ) (hN : 1 ≤ N) (z : ℝ) :
    ThreeDFocal.focalClosure χ (ThreeDFocal.carrierBank N hN) z ↔
      ∑ n ∈ Finset.Icc 1 N, (Routing.walk q order gens strides).coeff n *
        (ThreeDFocal.carrierAmplitude n : ℂ) *
          Complex.exp ((ThreeDFocal.carrierPhase z n : ℂ) * Complex.I) = 0 := by
  show HarmonicCell.finiteB χ ThreeDFocal.carrierAmplitude (ThreeDFocal.carrierPhase z) N = 0 ↔ _
  unfold HarmonicCell.finiteB
  rw [Finset.sum_congr rfl fun n _ => by
    rw [character_eq_walk χ order gens strides hχ hgen n]]
  rfl

/-! ## Routed focal closure → the 3D harmonic pencil (ledger 1144)

The existing bridge (ThreeDFocalEvent): `focalClosure_iff_rankDrop` (focal closure ⟺ rank drop of
the harmonic Gram pencil `!![A, B; μA, λB]`, determinant `(λ − μ)·A·B`), lifted uniformly over the
three spatial coordinates (`harmonicGram3D = G ⊗ I₃`, `harmonicGram3D_rankDrop_iff`). Its unsigned
channel is `A = finiteA χ a N = Σ ‖χ(n)‖·a(n)`, a sum of PLANE norms. With the routed walk:
`routed_focalClosure_iff_rankDrop` (the routing passes through), `finiteA_routed`,
`carrier_mass_split` (total carrier mass = A + neutral mass), and the first incompatibility,
`finiteA_lt_total_mass`: the pencil's unsigned channel misses the neutral mass. -/

/-- **The routed focal closure is the pencil rank drop**: the existing bridge consumes the walk. -/
theorem routed_focalClosure_iff_rankDrop {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    (order : ℕ) (gens strides : List ℕ)
    (hχ : List.Forall₂ (fun (g st : ℕ) => χ ((g : ℕ) : ZMod q) =
      Complex.exp (2 * Real.pi * Complex.I * (st : ℂ) / (order : ℂ))) gens strides)
    (hgen : ∀ u : (ZMod q)ˣ, ∃ ks ∈ stepTuples q gens.length,
      (((List.zipWith (fun g k => g ^ k) gens ks).prod : ℕ) : ZMod q) = (u : ZMod q))
    (N : ℕ) (hN : 1 ≤ N) (z : ℝ) (μ lam : ℂ) (hlam : lam ≠ μ) :
    (∑ n ∈ Finset.Icc 1 N, (Routing.walk q order gens strides).coeff n *
        (ThreeDFocal.carrierAmplitude n : ℂ) *
          Complex.exp ((ThreeDFocal.carrierPhase z n : ℂ) * Complex.I) = 0) ↔
      ThreeDFocal.FocalRankDrop χ (ThreeDFocal.carrierBank N hN) z μ lam := by
  rw [← focalClosure_carrierBank_routed χ order gens strides hχ hgen N hN z]
  exact ThreeDFocal.focalClosure_iff_rankDrop χ _ z μ lam hlam

/-- The pencil's unsigned channel, routed: routed-coefficient norms times the bank amplitude. -/
theorem finiteA_routed {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    (order : ℕ) (gens strides : List ℕ)
    (hχ : List.Forall₂ (fun (g st : ℕ) => χ ((g : ℕ) : ZMod q) =
      Complex.exp (2 * Real.pi * Complex.I * (st : ℂ) / (order : ℂ))) gens strides)
    (hgen : ∀ u : (ZMod q)ˣ, ∃ ks ∈ stepTuples q gens.length,
      (((List.zipWith (fun g k => g ^ k) gens ks).prod : ℕ) : ZMod q) = (u : ZMod q))
    (a : ℕ → ℝ) (N : ℕ) :
    HarmonicCell.finiteA χ a N =
      ∑ n ∈ Finset.Icc 1 N, ‖(Routing.walk q order gens strides).coeff n‖ * a n := by
  unfold HarmonicCell.finiteA
  exact Finset.sum_congr rfl fun n _ => by
    rw [character_eq_walk χ order gens strides hχ hgen n]
    rfl

/-- **The total carrier mass splits into the pencil's unsigned channel and the neutral mass.** -/
theorem carrier_mass_split {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    (order : ℕ) (gens strides : List ℕ)
    (hχ : List.Forall₂ (fun (g st : ℕ) => χ ((g : ℕ) : ZMod q) =
      Complex.exp (2 * Real.pi * Complex.I * (st : ℂ) / (order : ℂ))) gens strides)
    (hgen : ∀ u : (ZMod q)ˣ, ∃ ks ∈ stepTuples q gens.length,
      (((List.zipWith (fun g k => g ^ k) gens ks).prod : ℕ) : ZMod q) = (u : ZMod q))
    (a : ℕ → ℝ) (N : ℕ) :
    ∑ n ∈ Finset.Icc 1 N, a n = HarmonicCell.finiteA χ a N +
      ∑ n ∈ Finset.Icc 1 N, (1 - ‖(Routing.walk q order gens strides).coeff n‖) * a n := by
  rw [finiteA_routed χ order gens strides hχ hgen, ← Finset.sum_add_distrib]
  exact Finset.sum_congr rfl fun n _ => by ring

/-- **The first incompatibility.** Once the conductor's site is in the bank with positive amplitude,
the pencil's unsigned channel is strictly less than the total carrier mass: the neutral mass is
not an entry of the pencil. -/
theorem finiteA_lt_total_mass {q : ℕ} [NeZero q] [Fact (1 < q)] (χ : DirichletCharacter ℂ q)
    (order : ℕ) (gens strides : List ℕ)
    (hχ : List.Forall₂ (fun (g st : ℕ) => χ ((g : ℕ) : ZMod q) =
      Complex.exp (2 * Real.pi * Complex.I * (st : ℂ) / (order : ℂ))) gens strides)
    (hgen : ∀ u : (ZMod q)ˣ, ∃ ks ∈ stepTuples q gens.length,
      (((List.zipWith (fun g k => g ^ k) gens ks).prod : ℕ) : ZMod q) = (u : ZMod q))
    (a : ℕ → ℝ) (ha : ∀ n, 0 ≤ a n) (N : ℕ) (hqN : q ≤ N) (haq : 0 < a q) :
    HarmonicCell.finiteA χ a N < ∑ n ∈ Finset.Icc 1 N, a n := by
  rw [carrier_mass_split χ order gens strides hχ hgen a N]
  have hq1 : 1 ≤ q := le_of_lt (Fact.out : 1 < q)
  have hneutral : 0 < ∑ n ∈ Finset.Icc 1 N,
      (1 - ‖(Routing.walk q order gens strides).coeff n‖) * a n := by
    apply Finset.sum_pos'
    · intro n hn
      have hn0 : 0 < n := (Finset.mem_Icc.mp hn).1
      rcases routing_coeff_norm (Routing.walk q order gens strides) n hn0 with h | h <;>
        rw [h] <;> simp [ha n]
    · refine ⟨q, Finset.mem_Icc.mpr ⟨hq1, hqN⟩, ?_⟩
      rw [walk_coeff_at_conductor χ order gens strides hχ hgen]
      simpa using haq
  linarith

/-- Instance: Mathlib's χ₄ on the carrier bank. From `N ≥ 4` the pencil's unsigned channel misses
the neutral carrier mass. -/
theorem chi4_finiteA_lt_total_mass (N : ℕ) (hN : 4 ≤ N) :
    HarmonicCell.finiteA chi4Dirichlet ThreeDFocal.carrierAmplitude N <
      ∑ n ∈ Finset.Icc 1 N, ThreeDFocal.carrierAmplitude n := by
  have : Fact (1 < 4) := ⟨by norm_num⟩
  exact finiteA_lt_total_mass chi4Dirichlet 2 [3] [1] chi4_walk_values chi4_walk_units
    ThreeDFocal.carrierAmplitude
    (fun n => (ThreeDFocal.carrierBank 1 le_rfl).amplitude_nonneg n) N hN
    (carrierAmplitude_pos 4 (by norm_num))

/-! ## The routed bank in the enriched pencil (ledger 1145)

The neutral mass of a routed bank gets its own channel (`EnrichedPencil.enrichedPencil`). For a
character walk on the carrier bank, the enriched pencil's rank drop is exactly the existing focal
rank drop (`routed_enriched_rankDrop_iff`), while the neutral mass is carried and, once the
conductor's site is in the bank, positive (`routed_neutralMass_pos`). -/

/-- The neutral mass of a routed bank: `Σ (1 − ‖coeff n‖)·a(n)` over the sites in the bank. -/
noncomputable def neutralMass (r : Routing) (a : ℕ → ℝ) (N : ℕ) : ℝ :=
  ∑ n ∈ Finset.Icc 1 N, (1 - ‖r.coeff n‖) * a n

/-- The routed bank's enriched pencil: charged unsigned, charged signed, neutral. -/
noncomputable def routedEnrichedPencil {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    (r : Routing) (N : ℕ) (z : ℝ) (μ lam : ℂ) : Matrix (Fin 2) (Fin 3) ℂ :=
  EnrichedPencil.enrichedPencil (HarmonicCell.finiteA χ ThreeDFocal.carrierAmplitude N)
    (HarmonicCell.finiteB χ ThreeDFocal.carrierAmplitude (ThreeDFocal.carrierPhase z) N)
    (neutralMass r ThreeDFocal.carrierAmplitude N) μ lam

open scoped Matrix in
/-- **Rank-drop equivalence on the routed carrier bank:** the enriched pencil's row Gram is singular
exactly at the existing focal rank drop. -/
theorem routed_enriched_rankDrop_iff {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    (r : Routing) (N : ℕ) (hN : 1 ≤ N) (z : ℝ) (μ lam : ℂ) (hlam : lam ≠ μ) :
    (routedEnrichedPencil χ r N z μ lam * (routedEnrichedPencil χ r N z μ lam)ᴴ).det = 0 ↔
      ThreeDFocal.FocalRankDrop χ (ThreeDFocal.carrierBank N hN) z μ lam := by
  have hA : HarmonicCell.finiteA χ ThreeDFocal.carrierAmplitude N ≠ 0 :=
    (HarmonicCell.finiteA_pos χ ThreeDFocal.carrierAmplitude N hN
      (carrierAmplitude_pos 1 one_pos)
      (fun n => (ThreeDFocal.carrierBank 1 le_rfl).amplitude_nonneg n)).ne'
  unfold routedEnrichedPencil
  rw [EnrichedPencil.enrichedPencil_rankDrop_iff _ _ _ _ _ hlam hA,
    ← ThreeDFocal.focalClosure_iff_rankDrop χ _ z μ lam hlam]
  rfl

/-- **Preservation on the routed bank:** the neutral mass is carried, total mass = charged + neutral,
and once the conductor's site is in the bank the neutral mass is positive. -/
theorem routed_neutralMass_pos {q : ℕ} [NeZero q] [Fact (1 < q)] (χ : DirichletCharacter ℂ q)
    (order : ℕ) (gens strides : List ℕ)
    (hχ : List.Forall₂ (fun (g st : ℕ) => χ ((g : ℕ) : ZMod q) =
      Complex.exp (2 * Real.pi * Complex.I * (st : ℂ) / (order : ℂ))) gens strides)
    (hgen : ∀ u : (ZMod q)ˣ, ∃ ks ∈ stepTuples q gens.length,
      (((List.zipWith (fun g k => g ^ k) gens ks).prod : ℕ) : ZMod q) = (u : ZMod q))
    (N : ℕ) (hqN : q ≤ N) (z : ℝ) (μ lam : ℂ) :
    routedEnrichedPencil χ (.walk q order gens strides) N z μ lam 0 2 =
        (neutralMass (.walk q order gens strides) ThreeDFocal.carrierAmplitude N : ℂ) ∧
      ∑ n ∈ Finset.Icc 1 N, ThreeDFocal.carrierAmplitude n =
        HarmonicCell.finiteA χ ThreeDFocal.carrierAmplitude N +
          neutralMass (.walk q order gens strides) ThreeDFocal.carrierAmplitude N ∧
      0 < neutralMass (.walk q order gens strides) ThreeDFocal.carrierAmplitude N := by
  have hsplit := carrier_mass_split χ order gens strides hχ hgen ThreeDFocal.carrierAmplitude N
  have hlt := finiteA_lt_total_mass χ order gens strides hχ hgen ThreeDFocal.carrierAmplitude
    (fun n => (ThreeDFocal.carrierBank 1 le_rfl).amplitude_nonneg n) N hqN
    (carrierAmplitude_pos q (lt_trans Nat.zero_lt_one (Fact.out : 1 < q)))
  refine ⟨rfl, hsplit, ?_⟩
  unfold neutralMass
  linarith

open scoped Matrix in
/-- Instance: Mathlib's χ₄ on the carrier bank, `N ≥ 4`: positive neutral mass carried, and the
enriched rank drop is the existing focal rank drop. -/
theorem chi4_enriched (N : ℕ) (hN : 4 ≤ N) (z : ℝ) (μ lam : ℂ) (hlam : lam ≠ μ) :
    0 < neutralMass (.walk 4 2 [3] [1]) ThreeDFocal.carrierAmplitude N ∧
      ((routedEnrichedPencil chi4Dirichlet (.walk 4 2 [3] [1]) N z μ lam *
          (routedEnrichedPencil chi4Dirichlet (.walk 4 2 [3] [1]) N z μ lam)ᴴ).det = 0 ↔
        ThreeDFocal.FocalRankDrop chi4Dirichlet (ThreeDFocal.carrierBank N (by omega)) z μ lam) := by
  have : Fact (1 < 4) := ⟨by norm_num⟩
  exact ⟨(routed_neutralMass_pos chi4Dirichlet 2 [3] [1] chi4_walk_values chi4_walk_units N hN
      z μ lam).2.2,
    routed_enriched_rankDrop_iff chi4Dirichlet _ N (by omega) z μ lam hlam⟩


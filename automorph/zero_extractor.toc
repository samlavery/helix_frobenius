\contentsline {section}{\numberline {18}Where the geometry is load-bearing}{37}{section.18}%
\contentsline {paragraph}{(G1) The lane split gives a series that converges \emph {on} the line.}{38}{section*.9}%
\contentsline {paragraph}{(G2) The same lane split imposes a cost, and it is linear.}{38}{section*.10}%
\contentsline {paragraph}{(G3) The $\mu _6$ cell width is what refutes the sector balance law.}{38}{section*.11}%
\contentsline {paragraph}{(G4) The ordinate variable and the lane factor give the abscissa reading its dictionary \emph {and} its calibration.}{38}{section*.12}%
\contentsline {paragraph}{(G5) The double end is what produces the off-line pairing.}{38}{section*.13}%
\contentsline {paragraph}{(G6) The radial direction is what makes the band verification possible.}{39}{section*.14}%
\contentsline {paragraph}{(G7) The rank carries a count, and the eigenvalues carry the abscissa.}{39}{section*.15}%
\contentsline {paragraph}{(G8) The focal picture is a theorem, for characters the identification misses.}{39}{section*.16}%
\contentsline {paragraph}{(G9) The fiber has a Hamiltonian, and the critical line is where its Hilbert space ends.}{39}{section*.17}%
\contentsline {paragraph}{What this does not amount to.}{40}{section*.18}%
\contentsline {section}{\numberline {19}What is not claimed}{40}{section.19}%
\contentsline {section}{\numberline {20}Remaining obligations}{42}{section.20}%
\contentsline {paragraph}{(O1) The implementation realises the product theorem, not the capstone, and its arithmetic is not certified.}{42}{section*.19}%
\contentsline {paragraph}{(O2) The count is $O(i)$ in the index, and a bound on $S$ would make it $O(1)$.}{43}{section*.20}%
\contentsline {paragraph}{(O3) Two error terms are measured and not proved.}{45}{section*.21}%
\contentsline {paragraph}{(O4) The two-ended head, realised.}{45}{section*.22}%
\contentsline {paragraph}{(O5) An explicit bound on $\lvert \Xi \rvert $ over a region.}{46}{section*.23}%
